# ---------------------------------------------------------------------------
# SnappPay (اسنپ‌پی) — copy these into the server's .env (never commit .env).
# Staging values were provided by SnappPay in "odour-stage.txt".
# ---------------------------------------------------------------------------
# Staging: https://fms-gateway-staging.apps.public.okd4.teh-1.snappcloud.io/
# Production: the base URL SnappPay sends after final approval.
SNAPPPAY_BASE_URL=https://fms-gateway-staging.apps.public.okd4.teh-1.snappcloud.io/
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=

# Public HTTPS address of the site; the callback is
# ${SITE_URL}/api/order/snapp-pay/callback
SITE_URL=https://www.odour.ir

# Optional tuning (defaults shown)
# SNAPPPAY_TIMEOUT_MS=30000
# SNAPPPAY_PAYMENT_METHOD_TYPE_DTO=INSTALLMENT
# Automatic Get Payment Status reconciliation
# SNAPPPAY_RECONCILE_INTERVAL_MINUTES=5
# SNAPPPAY_RECONCILE_MIN_AGE_MINUTES=15
# SNAPPPAY_PENDING_EXPIRE_MINUTES=60
# SNAPPPAY_STALE_LOCK_MINUTES=10
# Optional PDP visibility range in toman (PDP never calls eligible)
# SNAPPPAY_PDP_MIN_TOMAN=0
# SNAPPPAY_PDP_MAX_TOMAN=0
