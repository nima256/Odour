<script>
  // --------------------------------------------------------------
  // DEFAULT CONFIG (single-slide version with 4 interchangeable fields)
  // --------------------------------------------------------------
  const defaultConfig = {
    background_color: "#FFD1DC",
    surface_color: "#FFFFFF",
    text_color: "#51313C",
    primary_action_color: "#51313C",
    secondary_action_color: "#E87899",
    font_family: "Vazirmatn",
    font_size: 12,
    brand_name: "نی‌نی پوش",
    badge_text: "تازه‌های فصل کوچولوها",
    main_title: "لباس‌های لطیف برای روزهای شیرین",
    main_description: "کالکشن تازه نوزادی با پارچه‌های نرم و رنگ‌های آرام",
    primary_button_text: "دیدن کالکشن",
    secondary_button_text: "بات هوشمند خرید لباس"
  };

  // Helper to set text content safely
  function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  // Apply config to all styles and texts
  async function onConfigChange(config) {
    const bg = config.background_color || defaultConfig.background_color;
    const surface = config.surface_color || defaultConfig.surface_color;
    const text = config.text_color || defaultConfig.text_color;
    const primary = config.primary_action_color || defaultConfig.primary_action_color;
    const accent = config.secondary_action_color || defaultConfig.secondary_action_color;
    const fontFamily = config.font_family || defaultConfig.font_family;
    const baseFontSize = config.font_size || defaultConfig.font_size;
    const fontStack = `${fontFamily}, Vazirmatn, Tahoma, sans-serif`;

    // 1. background shell
    const shell = document.getElementById("pageShell");
    shell.style.background = `
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.95) 0 12%, transparent 13%),
      radial-gradient(circle at 82% 72%, rgba(255, 255, 255, 0.7) 0 10%, transparent 11%),
      linear-gradient(135deg, ${bg} 0%, #fff7f9 48%, ${surface} 100%)
    `;
    shell.style.color = text;
    shell.style.fontFamily = fontStack;

    // 2. main card background (translucent surface)
    const heroCard = document.querySelector(".hero-card");
    if (heroCard) heroCard.style.backgroundColor = `${surface}B8`; // 72% opacity

    // 3. Headings, lead, labels, buttons
    const allH1 = document.querySelectorAll("h1");
    allH1.forEach(el => {
      el.style.color = text;
      el.style.fontFamily = fontStack;
      el.style.fontSize = `${baseFontSize * 3.8}px`;
    });

    const leads = document.querySelectorAll(".lead");
    leads.forEach(el => {
      el.style.color = text;
      el.style.fontFamily = fontStack;
      el.style.fontSize = `${baseFontSize * 1.25}px`;
    });

    const brandPill = document.querySelector(".brand-pill");
    if (brandPill) {
      brandPill.style.backgroundColor = surface;
      brandPill.style.color = text;
      brandPill.style.fontSize = `${baseFontSize * 0.95}px`;
    }

    const decoBadge = document.querySelector(".deco-badge");
    if (decoBadge) {
      decoBadge.style.backgroundColor = `${text}14`; // subtle
      decoBadge.style.color = text;
      decoBadge.style.fontSize = `${baseFontSize * 0.82}px`;
    }

    const miniLabelDiv = document.querySelector(".mini-label");
    if (miniLabelDiv) {
      miniLabelDiv.style.backgroundColor = `${bg}B8`;
      miniLabelDiv.style.color = text;
      miniLabelDiv.style.fontSize = `${baseFontSize * 0.88}px`;
    }
    const miniSpan = document.querySelector(".mini-label span");
    if (miniSpan) miniSpan.style.backgroundColor = accent;

    // Buttons
    const primaryBtns = document.querySelectorAll(".primary-btn");
    primaryBtns.forEach(btn => {
      btn.style.backgroundColor = primary;
      btn.style.color = surface;
      btn.style.fontSize = `${baseFontSize * 0.98}px`;
    });
    const secondaryBtns = document.querySelectorAll(".secondary-btn");
    secondaryBtns.forEach(btn => {
      btn.style.backgroundColor = surface;
      btn.style.color = text;
      btn.style.fontSize = `${baseFontSize * 0.98}px`;
    });

    // Brand mark, active dots if any (though there is no slider, but for completeness)
    const brandMarkDiv = document.querySelector(".brand-mark");
    if (brandMarkDiv) brandMarkDiv.style.backgroundColor = bg;
    
    // optional: also style .hero-button focus state etc
    // update text fields from config
    setText("brandName", config.brand_name || defaultConfig.brand_name);
    setText("badgeText", config.badge_text || defaultConfig.badge_text);
    setText("mainTitle", config.main_title || defaultConfig.main_title);
    setText("mainDescription", config.main_description || defaultConfig.main_description);
    setText("primaryBtnText", config.primary_button_text || defaultConfig.primary_button_text);
    setText("secondaryBtnText", config.secondary_button_text || defaultConfig.secondary_button_text);
  }

  // ------ BUTTON INTERACTION (demo feedback) ------
  const primaryButton = document.getElementById("primaryBtnAction");
  const secondaryButton = document.getElementById("secondaryBtnAction");
  if (primaryButton) {
    primaryButton.addEventListener("click", () => {
      const originalText = document.getElementById("primaryBtnText").textContent;
      const btnSpan = document.getElementById("primaryBtnText");
      btnSpan.textContent = "✨ به‌زودی آماده می‌شود ✨";
      setTimeout(() => { btnSpan.textContent = originalText; }, 1600);
    });
  }
  if (secondaryButton) {
    secondaryButton.addEventListener("click", () => {
      const originalText = document.getElementById("secondaryBtnText").textContent;
      const btnSpan = document.getElementById("secondaryBtnText");
     
      setTimeout(() => { btnSpan.textContent = originalText; }, 1600);
    });
  }

  // ------ SDK INTEGRATION (exactly as before but mapped to single slide fields) ------
  if (window.elementSdk) {
    window.elementSdk.init({
      defaultConfig,
      onConfigChange,
      mapToCapabilities: (config) => ({
        recolorables: [
          { get: () => config.background_color || defaultConfig.background_color, set: (v) => window.elementSdk.setConfig({ background_color: v }) },
          { get: () => config.surface_color || defaultConfig.surface_color, set: (v) => window.elementSdk.setConfig({ surface_color: v }) },
          { get: () => config.text_color || defaultConfig.text_color, set: (v) => window.elementSdk.setConfig({ text_color: v }) },
          { get: () => config.primary_action_color || defaultConfig.primary_action_color, set: (v) => window.elementSdk.setConfig({ primary_action_color: v }) },
          { get: () => config.secondary_action_color || defaultConfig.secondary_action_color, set: (v) => window.elementSdk.setConfig({ secondary_action_color: v }) }
        ],
        borderables: [],
        fontEditable: {
          get: () => config.font_family || defaultConfig.font_family,
          set: (v) => window.elementSdk.setConfig({ font_family: v })
        },
        fontSizeable: {
          get: () => config.font_size || defaultConfig.font_size,
          set: (v) => window.elementSdk.setConfig({ font_size: v })
        }
      }),
      mapToEditPanelValues: (config) => new Map([
        ["brand_name", config.brand_name || defaultConfig.brand_name],
        ["badge_text", config.badge_text || defaultConfig.badge_text],
        ["main_title", config.main_title || defaultConfig.main_title],
        ["main_description", config.main_description || defaultConfig.main_description],
        ["primary_button_text", config.primary_button_text || defaultConfig.primary_button_text],
        ["secondary_button_text", config.secondary_button_text || defaultConfig.secondary_button_text]
      ])
    });
  } else {
    // Apply default config on load
    onConfigChange(defaultConfig);
  }
</script>

<script>
  // اسکریپت اسلایدر
  document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.querySelector('.slider-prev');
    const nextBtn = document.querySelector('.slider-next');
    let currentSlide = 0;
    let autoPlayInterval;
    
    // تابع تغییر تصویر بر اساس سایز صفحه
    function setResponsiveBackgrounds() {
      const isMobile = window.innerWidth <= 768;
      
      slides.forEach(slide => {
        const bgDiv = slide.querySelector('.slide-bg');
        if (bgDiv) {
          const mobileImg = bgDiv.getAttribute('data-mobile');
          const desktopImg = bgDiv.getAttribute('data-desktop');
          const imageUrl = isMobile ? mobileImg : desktopImg;
          bgDiv.style.backgroundImage = `url('${imageUrl}')`;
        }
      });
    }
    
    // تابع نمایش اسلاید
    function showSlide(index) {
      slides.forEach(slide => slide.classList.remove('active'));
      dots.forEach(dot => dot.classList.remove('active'));
      
      slides[index].classList.add('active');
      dots[index].classList.add('active');
      currentSlide = index;
    }
    
    // اسلاید بعدی
    function nextSlide() {
      let newIndex = currentSlide + 1;
      if (newIndex >= slides.length) newIndex = 0;
      showSlide(newIndex);
    }
    
    // اسلاید قبلی
    function prevSlide() {
      let newIndex = currentSlide - 1;
      if (newIndex < 0) newIndex = slides.length - 1;
      showSlide(newIndex);
    }
    
    // شروع auto-play
    function startAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(nextSlide, 5000);
    }
    
    // توقف auto-play
    function stopAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
    }
    
    // رویدادها
    nextBtn.addEventListener('click', () => {
      nextSlide();
      stopAutoPlay();
      startAutoPlay();
    });
    
    prevBtn.addEventListener('click', () => {
      prevSlide();
      stopAutoPlay();
      startAutoPlay();
    });
    
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const slideIndex = parseInt(dot.getAttribute('data-dot'));
        showSlide(slideIndex);
        stopAutoPlay();
        startAutoPlay();
      });
    });
    
    // وقتی پنجره resize میشود
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        setResponsiveBackgrounds();
      }, 250);
    });
    
    // اجرا در شروع
    setResponsiveBackgrounds();
    startAutoPlay();
    
    // توقف auto-play وقتی موس روی اسلایدر است
    const slider = document.querySelector('.hero-slider');
    slider.addEventListener('mouseenter', stopAutoPlay);
    slider.addEventListener('mouseleave', startAutoPlay);
  });
  // اضافه کردن event listener برای دکمه خرید اسلایدر
document.addEventListener('DOMContentLoaded', function() {
  const heroShopBtn = document.getElementById('heroShopBtn');
  if (heroShopBtn) {
    heroShopBtn.addEventListener('click', function(e) {
      e.preventDefault();
      openModal(); // تابع openModal که قبلاً در کد شما وجود دارد
    });
  }
});
</script>

