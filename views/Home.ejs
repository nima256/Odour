<style>
  /* اطمینان از display grid صحیح */
  .grid {
    display: grid;
  }
  
  .grid-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  
  /* اطمینان از aspect-square در مرورگرهای قدیمی */
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
  
  /* پشتیبانی از aspect-ratio در مرورگرهای قدیمی‌تر */
  @supports not (aspect-ratio: 1/1) {
    .aspect-square {
      position: relative;
      padding-bottom: 100%;
