        if (!window.currentWeblogImages) {
            window.currentWeblogImages = [];
        }
        
        imagesWithCaptions.forEach((image, idx) => {
            window.currentWeblogImages.push(image);
            
            const imgContainer = document.createElement('div');
            imgContainer.className = 'relative group border border-gray-200 rounded-lg p-2 bg-gray-50';
