                            <span class="text-sm font-medium text-gray-700">محصول جدید</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-xl cursor-pointer hover:bg-gray-100 transition-all">
                            <input type="checkbox" id="editIsPopular" class="w-4 h-4 text-red-600 rounded">
                            <span class="text-sm font-medium text-gray-700">محصول پرطرفدار</span>
                        </label>
                    </div>
                </div>

                <div class="bg-gradient-to-r from-gray-50 to-white rounded-xl p-4 md:p-5 border border-gray-200">
                    <h4 class="text-base md:text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 border-r-4 border-emerald-500 pr-3">
                        <i class="fas fa-globe text-emerald-500"></i>
                        وضعیت انتشار
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="flex items-center gap-2 p-3 bg-gray-50 rounded-xl cursor-pointer hover:bg-gray-100 transition-all">
                            <input type="checkbox" id="editIsPublished" class="w-4 h-4 text-emerald-600 rounded">
                            <span class="text-sm font-medium text-gray-700">منتشر شده (فعال در فروشگاه)</span>
                        </label>
                        <div class="text-xs text-gray-500 flex items-center">
                            <i class="fas fa-info-circle ml-1"></i>
                            در صورت فعال بودن، محصول در سایت نمایش داده می‌شود
                        </div>
                    </div>
                </div>


                <%- include('./partials/admin-product-extras') %>
            </div>
            
            <!-- Footer با دکمه‌ها -->
            <div class="sticky bottom-0 bg-gray-50 border-t border-gray-200 px-5 md:px-7 py-4 flex flex-col sm:flex-row justify-end gap-3">
