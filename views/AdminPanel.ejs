function weblogImageHandler() {
    const input = document.createElement('input');
    input.setAttribute('type', 'file');
    input.setAttribute('accept', 'image/*');
    input.click();
    
    input.onchange = async function() {
        const file = input.files[0];
        if (!file) return;
        
        try {
            const range = weblogQuillEditor.getSelection();
            const placeholderIndex = range ? range.index : 0;
            weblogQuillEditor.insertEmbed(placeholderIndex, 'image', '/loading.gif');
            
            const formData = new FormData();
            formData.append('image', file);
            
            const response = await fetch('/admin/upload-image', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success && result.url) {
                weblogQuillEditor.deleteText(placeholderIndex, 1);
                
                const captionText = prompt('لطفاً توضیحات تصویر را وارد کنید:', '');
                
                const htmlToInsert = `<figure class="weblog-image-figure" style="margin: 20px 0; text-align: center;">
                    <img src="${result.url}" alt="${escapeHtml(captionText || '')}" title="${escapeHtml(captionText || '')}" style="max-width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <figcaption class="weblog-image-caption" style="font-size: 13px; color: #666; margin-top: 8px; padding: 5px; border-bottom: 1px dashed #ddd; cursor: text; text-align: center;" contenteditable="true">${escapeHtml(captionText || '')}</figcaption>
                </figure>`;
                
                weblogQuillEditor.insertEmbed(placeholderIndex, 'html', htmlToInsert);
                
                showNotification('تصویر با موفقیت آپلود شد', 'success');
            } else {
                weblogQuillEditor.deleteText(placeholderIndex, 1);
                showNotification('خطا در آپلود تصویر', 'error');
            }
        } catch (error) {
            console.error('Error uploading image:', error);
            showNotification('خطا در آپلود تصویر', 'error');
        }
    };
}

// آپلود تصاویر مقاله با قابلیت کپشن
// نسخه ساده‌تر با prompt (بدون پاپ‌آپ اضافی)
async function uploadWeblogImagesWithCaption(files) {
    if (!files || files.length === 0) return [];
    
    const uploadedImages = [];
    
    for (let i = 0; i < files.length; i++) {
        const file = files[i];
        
        const formData = new FormData();
        formData.append('images', file);
        
        try {
            const response = await fetch('/admin/upload-images', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (!response.ok) {
                throw new Error(result.error || 'خطا در آپلود تصویر');
            }
            
            if (result.images && result.images.length > 0) {
                const imageData = result.images[0];
                const captionText = prompt('لطفاً توضیحات تصویر را وارد کنید:', '');
                
                uploadedImages.push({
                    url: imageData.url,
                    filename: imageData.filename,
                    caption: captionText || '',
                    alt: captionText || ''
                });
            }
        } catch (error) {
            console.error('Image upload error:', error);
            showNotification('خطا در آپلود تصویر: ' + error.message, 'error');
        }
    }
    
    return uploadedImages;
}

// نمایش پیش‌نمایش تصاویر مقاله با قابلیت ویرایش کپشن
function displayWeblogImagePreviews(images) {
    const container = document.getElementById('weblogImagePreviews');
    if (!container) return;
    
    container.innerHTML = '';
    
    images.forEach((image, index) => {
        const imgContainer = document.createElement('div');
        imgContainer.className = 'relative group border border-gray-200 rounded-lg p-2 bg-gray-50';
        imgContainer.style.width = '200px';
        imgContainer.dataset.filename = image.filename;
        imgContainer.dataset.caption = image.caption || image.alt || '';
        imgContainer.innerHTML = `
            <div class="relative">
                <img src="${image.url}" class="w-full h-32 object-cover rounded-lg" alt="${escapeHtml(image.caption || image.alt || '')}" title="${escapeHtml(image.caption || image.alt || '')}">
                <button type="button" onclick="removeWeblogImage(this, '${image.url}', '${image.filename}')" 
                    class="absolute top-2 right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs hover:bg-red-600 transition-all opacity-0 group-hover:opacity-100">
                    ×
                </button>
            </div>
            <div class="mt-2">
                <div class="flex items-center gap-1">
                    <i class="fas fa-pen text-gray-400 text-xs"></i>
                    <input type="text" 
                           class="caption-input w-full text-xs border border-gray-200 rounded px-2 py-1 focus:border-blue-400 focus:outline-none" 
                           value="${escapeHtml(image.caption || image.alt || '')}" 
                           placeholder="توضیح تصویر..."
                           data-index="${index}">
                </div>
            </div>
        `;
        container.appendChild(imgContainer);
        
        // افزودن event listener برای ذخیره کپشن هنگام تغییر
        const captionInput = imgContainer.querySelector('.caption-input');
        captionInput.addEventListener('change', function() {
            const newCaption = this.value.trim();
            imgContainer.dataset.caption = newCaption;
            const img = imgContainer.querySelector('img');
            if (img) {
                img.setAttribute('alt', newCaption);
                img.setAttribute('title', newCaption);
            }
            // آپدیت کردن در آرایه images (اختیاری)
            if (window.currentWeblogImages && window.currentWeblogImages[index]) {
                window.currentWeblogImages[index].caption = newCaption;
            }
        });
    });
}

// تابع کمکی برای escape کردن HTML
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// حذف تصویر مقاله با کپشن
async function removeWeblogImageWithCaption(buttonElement, imageUrl, filename, index) {
    if (!confirm('آیا از حذف این تصویر مطمئن هستید؟')) return;
    
    try {
        const response = await fetch('/admin/delete-image', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename })
        });
        
        const result = await response.json();
        
        if (!response.ok) {
            throw new Error(result.error || 'حذف تصویر انجام نشد');
        }
        
        buttonElement.parentElement.remove();
        showNotification('تصویر با موفقیت حذف شد', 'success');
        
        // به‌روزرسانی آرایه تصاویر
        if (window.currentWeblogImages) {
            window.currentWeblogImages.splice(index, 1);
        }
    } catch (error) {
        console.error('Image deletion error:', error);
        showNotification('خطا در حذف تصویر: ' + error.message, 'error');
    }
}

