        function renderOrders() {
            const tbody = document.getElementById('ordersTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const query = (document.getElementById('orderSearchInput')?.value || '').trim().toLowerCase();
            const filteredOrders = orders.filter(order => {
                if (!query) return true;
                return [
                    order.OrderNum,
                    order.snappPay?.transactionId,
                    order.torobPay?.transactionId,
                    order.paymentMethod,
                    order.user?.fullName,
                    order.user?.mobile,
                    order.recipientName,
                    order.recipientMobile,
                ].some(value => String(value || '').toLowerCase().includes(query));
            });

            if (!filteredOrders.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-8 text-gray-500">سفارشی مطابق جستجو پیدا نشد</td></tr>';
                return;
            }

            filteredOrders.forEach((order) => {
                const row = document.createElement('tr');
                row.className = 'product-row transition-all duration-300';
                const statusClasses = {
                    'در انتظار پرداخت': 'bg-orange-100 text-orange-800',
                    'در حال پردازش': 'bg-yellow-100 text-yellow-800',
                    'بسته بندی شده': 'bg-blue-100 text-blue-800',
                    'در حال ارسال': 'bg-purple-100 text-purple-800',
                    'تحویل داده شد': 'bg-green-100 text-green-800',
                    'لغو شده': 'bg-red-100 text-red-800'
                };
                const classForStatus = statusClasses[order.status] || 'bg-gray-100 text-gray-800';
                const dateTimeDisplay = order.formattedDateTime || order.createTarikh || '-';
                const transactionId = order.torobPay?.transactionId || order.snappPay?.transactionId || '';
                const transactionGateway = order.paymentMethod === 'ترب‌پی' ? 'ترب‌پی' : (order.paymentMethod === 'اسنپ‌پی' ? 'اسنپ‌پی' : '');

                row.innerHTML = `
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm font-medium text-gray-900">
                        <div>${order.OrderNum}</div>
                        ${transactionId ? `<div class="mt-1 text-[11px] text-blue-700 select-all" title="شناسه تراکنش ${transactionGateway}">${transactionId}</div>` : ''}
                    </td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-900 hidden md:table-cell">${order.recipientName || order.user?.fullName || 'نامشخص'}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm font-semibold text-green-600">${toPersianDigits(order.totalPrice)} تومان</td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm">
                        <span class="inline-flex px-2 py-1 rounded-full bg-slate-100 text-slate-700 font-semibold">${order.paymentMethod || '-'}</span>
                    </td>
                    <td class="px-3 md:px-6 py-3 md:py-4">
                        <select onchange="updateOrderStatus('${order._id}', this)"
                            class="${classForStatus} px-2 md:px-3 py-1 rounded-full text-xs font-medium border-none">
                            <option value="pending" ${order.status === 'در حال پردازش' || order.status === 'در انتظار پرداخت' ? 'selected' : ''}>در حال پردازش</option>
                            <option value="processing" ${order.status === 'بسته بندی شده' ? 'selected' : ''}>بسته بندی شده</option>
                            <option value="shipping" ${order.status === 'در حال ارسال' ? 'selected' : ''}>در حال ارسال</option>
                            <option value="delivered" ${order.status === 'تحویل داده شد' ? 'selected' : ''}>تحویل داده شد</option>
                            <option value="cancelled" ${order.status === 'لغو شده' ? 'selected' : ''}>لغو شده</option>
                        </select>
                    </td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-600 hidden sm:table-cell">${dateTimeDisplay}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4">
                        <button onclick="viewOrder('${order._id}')" class="action-btn p-1 md:p-2 text-blue-600 hover:bg-blue-50 rounded-full transition-all">
                            <i class="fas fa-eye text-sm"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

