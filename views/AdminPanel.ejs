        function toPersianDigits(num) {
            if (num === null || num === undefined || isNaN(num)) return "";
            const persianDigits = "۰۱۲۳۴۵۶۷۸۹";
            const withCommas = num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            return withCommas.replace(/\d/g, (digit) => persianDigits[digit]);
        }

        let products = <%- JSON.stringify(products).replace(/</g, '\\u003c') %>


        // Product Functions
        const ADMIN_PRODUCTS_PER_PAGE = 20;
        let adminProductCurrentPage = 1;
        let adminProductSearchQuery = '';

        function hasProductDiscount(product) {
            const price = Number(product?.price || 0);
            const offerPrice = Number(product?.offerPrice || 0);
            return offerPrice > 0 && price > 0 && offerPrice < price;
        }

        function getAdminProductSearchText(product) {
            const categoriesText = Array.isArray(product?.category)
                ? product.category.map(cat => cat?.name || '').join(' ')
                : '';
            const brandText = typeof product?.brand === 'object'
                ? (product.brand?.name || '')
                : (product?.brand || '');
            return [product?.name, product?.englishName, product?.slug, categoriesText, brandText]
                .filter(Boolean)
                .join(' ')
                .toLocaleLowerCase('fa');
        }

        function changeAdminProductPage(page) {
            const filteredCount = getFilteredAdminProducts().length;
            const totalPages = Math.max(1, Math.ceil(filteredCount / ADMIN_PRODUCTS_PER_PAGE));
            if (page < 1 || page > totalPages) return;
            adminProductCurrentPage = page;
            loadProducts();
        }

        function getFilteredAdminProducts() {
            const sortedProducts = [...products].sort((a, b) => {
                const bDate = new Date(b?.createdAt || b?.updatedAt || 0).getTime();
                const aDate = new Date(a?.createdAt || a?.updatedAt || 0).getTime();
                return bDate - aDate;
            });
            const query = adminProductSearchQuery.trim().toLocaleLowerCase('fa');
            if (!query) return sortedProducts;
            return sortedProducts.filter(product => getAdminProductSearchText(product).includes(query));
        }

        function renderAdminProductPagination(totalItems) {
            const container = document.getElementById('productsPagination');
            if (!container) return;

            const totalPages = Math.max(1, Math.ceil(totalItems / ADMIN_PRODUCTS_PER_PAGE));
            if (totalItems <= ADMIN_PRODUCTS_PER_PAGE) {
                container.innerHTML = '';
                return;
            }

            const startPage = Math.max(1, adminProductCurrentPage - 2);
            const endPage = Math.min(totalPages, startPage + 4);
            let html = `
                <button type="button" onclick="changeAdminProductPage(${adminProductCurrentPage - 1})"
                    class="px-3 py-2 rounded-lg border bg-white text-sm ${adminProductCurrentPage === 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-gray-50'}"
                    ${adminProductCurrentPage === 1 ? 'disabled' : ''}>قبلی</button>`;

            for (let page = startPage; page <= endPage; page++) {
                html += `
                    <button type="button" onclick="changeAdminProductPage(${page})"
                        class="min-w-10 px-3 py-2 rounded-lg border text-sm ${page === adminProductCurrentPage ? 'gradient-bg text-white border-transparent' : 'bg-white hover:bg-gray-50'}">
                        ${toPersianDigits(page)}
                    </button>`;
            }

            html += `
                <button type="button" onclick="changeAdminProductPage(${adminProductCurrentPage + 1})"
                    class="px-3 py-2 rounded-lg border bg-white text-sm ${adminProductCurrentPage === totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-gray-50'}"
                    ${adminProductCurrentPage === totalPages ? 'disabled' : ''}>بعدی</button>`;
            container.innerHTML = html;
        }

        function loadProducts() {
            const tbody = document.getElementById('productsTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const filteredProducts = getFilteredAdminProducts();
            const totalPages = Math.max(1, Math.ceil(filteredProducts.length / ADMIN_PRODUCTS_PER_PAGE));
            if (adminProductCurrentPage > totalPages) adminProductCurrentPage = totalPages;

            const startIndex = (adminProductCurrentPage - 1) * ADMIN_PRODUCTS_PER_PAGE;
            const pageProducts = filteredProducts.slice(startIndex, startIndex + ADMIN_PRODUCTS_PER_PAGE);

            if (!pageProducts.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="px-4 py-10 text-center text-gray-500">
                            ${adminProductSearchQuery ? 'محصولی با این عبارت پیدا نشد.' : 'هنوز محصولی ثبت نشده است.'}
                        </td>
                    </tr>`;
            }

            pageProducts.forEach((product, index) => {
                const brandName = product.brand?.name ||
                                (typeof product.brand === 'string' ? 'در حال بارگذاری...' : 'نامشخص');

                const statusBadge = product.isPublished
                ? '<span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">منتشر شده</span>'
                : '<span class="inline-block bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full">پیش‌نویس</span>';

                const categoryBadges = product.category && product.category.length > 0
                    ? product.category.map(cat =>
                        `<span class="inline-block bg-gray-100 text-gray-800 text-xs px-2 py-1 rounded-full mr-1 mb-1">
                            ${escapeHtml(cat.name || (typeof cat === 'string' ? 'در حال بارگذاری...' : 'بدون نام'))}
                        </span>`
                    ).join('')
                    : '<span class="text-gray-500 text-xs">بدون دسته‌بندی</span>';

                const discounted = hasProductDiscount(product);
                const priceHtml = discounted
                    ? `<div class="flex flex-col gap-1">
                          <span class="text-gray-400 line-through font-normal">${toPersianDigits(product.price)} تومان</span>
                          <span class="text-green-600 font-bold">${toPersianDigits(product.offerPrice)} تومان</span>
                          <span class="w-fit bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-[10px]">قیمت ویژه</span>
                       </div>`
                    : `<span class="text-green-600 font-semibold">${toPersianDigits(product.price)} تومان</span>`;

                const row = document.createElement('tr');
                row.className = 'product-row transition-all duration-300';
                row.dataset.productId = product._id;
                row.innerHTML = `
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-900">${toPersianDigits(startIndex + index + 1)}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4">
                        <img src="${product.images?.[0]?.url || '/images/placeholder.png'}" alt="Product" class="w-12 h-12 md:w-16 md:h-16 rounded-lg object-cover">
                    </td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm font-medium text-gray-900">${escapeHtml(product.name || '')}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-600 hidden md:table-cell"><div class="flex flex-wrap">${categoryBadges}</div></td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-600 hidden md:table-cell">${escapeHtml(brandName)}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm text-gray-600 hidden sm:table-cell">${toPersianDigits(product.countInStock || 0)}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm">${priceHtml}</td>
                    <td class="px-3 md:px-6 py-3 md:py-4">
                        <div class="flex space-x-reverse space-x-1 md:space-x-2">
                            <button onclick="viewProduct('${product._id}')" class="action-btn p-1 md:p-2 text-blue-600 hover:bg-blue-50 rounded-full transition-all">
                                <i class="fas fa-eye text-sm"></i>
                            </button>
                            <button onclick="editProduct('${product._id}')" class="action-btn p-1 md:p-2 text-yellow-600 hover:bg-yellow-50 rounded-full transition-all">
                                <i class="fas fa-pencil text-sm"></i>
                            </button>
                            <button onclick="deleteProduct('${product._id}')" class="action-btn p-1 md:p-2 text-red-600 hover:bg-red-50 rounded-full transition-all">
                                <i class="fas fa-trash text-sm"></i>
                            </button>
                          <button class="btn btn-sm btn-secondary" onclick="duplicateProduct('${product._id}')">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </td>
                    <td class="px-3 md:px-6 py-3 md:py-4 text-xs md:text-sm">
                        ${statusBadge}
                    </td>
                `;
                tbody.appendChild(row);
            });

            const summary = document.getElementById('adminProductsResultSummary');
            if (summary) {
                const from = filteredProducts.length ? startIndex + 1 : 0;
                const to = Math.min(startIndex + ADMIN_PRODUCTS_PER_PAGE, filteredProducts.length);
                summary.textContent = `نمایش ${toPersianDigits(from)} تا ${toPersianDigits(to)} از ${toPersianDigits(filteredProducts.length)} محصول`;
            }
            renderAdminProductPagination(filteredProducts.length);
        }

