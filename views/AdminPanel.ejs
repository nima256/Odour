        async function handleImageUpload(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;
        
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const captionText = await showAdminInput({ title: 'ALT تصویر محصول', message: `برای تصویر «${file.name}» متن ALT / توضیح تصویر را وارد کنید.`, placeholder: 'توضیح کوتاه و دقیق تصویر', hint: 'بهتر است ALT کوتاه، توصیفی و مرتبط با خود محصول باشد.', confirmText: 'ادامه و آپلود', cancelText: 'آپلود بدون ALT' });
                
                const formData = new FormData();
                formData.append('image', file);
                
                try {
                    const response = await fetch('/admin/upload-image', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        // ذخیره با اطلاعات کامل
                        const imageData = {
                            url: result.url,
                            filename: result.filename,
                            caption: captionText || '',
                            alt: captionText || '',
                            tempPath: result.tempPath // اگر سرور tempPath برگرداند
                        };
                        addImageToPreview(imageData, captionText);
                        refreshAllColorImageSelects();
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    showNotification('خطا در آپلود تصویر', 'error');
                }
            }
            
            event.target.value = '';
        }

async function removeTempImage(buttonElement, tempId) {
    const confirmed = await showAdminConfirm({ title: 'حذف تصویر', message: 'آیا از حذف این تصویر از محصول مطمئن هستید؟', confirmText: 'حذف تصویر', danger: true });
    if (!confirmed) return;
    
