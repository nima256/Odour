        // Form Handlers
        document.getElementById('editForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // پاک کردن خطاهای قبلی
            clearFormErrors();
            
            // گرفتن محتوای ویرایشگر
            if (window.quillInstance) {
                const descriptionField = document.getElementById('editDescription');
                descriptionField.value = window.quillInstance.root.innerHTML;
            }
            
            // جمع‌آوری داده‌های فرم
            const hasDiscount = document.getElementById('hasDiscount').checked;
            const offerPriceField = document.getElementById('editOfferPrice');
            const weightField = document.getElementById('editWeight');
            const weightValue = weightField.value.trim();
            
            // جمع‌آوری تصاویر
            const images = [];
            document.querySelectorAll('#imagePreviews > div').forEach(container => {
                const img = container.querySelector('img');
                const captionInput = container.querySelector('.caption-input');
                if (img && img.src) {
                    images.push({
                        url: img.src,
                        filename: container.dataset.filename,
                        caption: captionInput ? captionInput.value.trim() : (container.dataset.caption || ''),
                        alt: captionInput ? captionInput.value.trim() : (container.dataset.caption || '')
                    });
                }
            });

            
            // قبل از ارسال، خلاصه‌ی موجودی را با ماتریس دقیق همگام می‌کنیم.
            syncInventoryUiFromMatrix();

            // ساخت آبجکت داده
            const data = {
                name: document.getElementById('editName').value.trim(),
                englishName: document.getElementById('editEnglishName').value.trim() || null,
                slug: document.getElementById('editSlug').value.trim() || undefined,
                lilDescription: document.getElementById('editLilDescription').value.trim(),
                description: document.getElementById('editDescription').value,
                price: parseFloat(document.getElementById('editPrice').value),
                offerPrice: hasDiscount && offerPriceField.value ? parseFloat(offerPriceField.value) : null,
                countInStock: parseInt(document.getElementById('editCountInStock').value),
                // اگر وزن خالی باشد، کلید weight در JSON ارسال نمی‌شود و وزن قبلی حفظ می‌شود.
                weight: weightValue === '' ? undefined : Number.parseFloat(weightValue),
                images: images,
                tags: document.getElementById('editTags').value ? document.getElementById('editTags').value.split(',').map(tag => tag.trim()).filter(t => t) : [],
                category: [document.getElementById('editCategory').value], // چون select تکی است
                brand: document.getElementById('editBrand').value,
                specialOfferPosition: document.getElementById('editSpecialOfferPosition').value ? Number(document.getElementById('editSpecialOfferPosition').value) : null,
                isPublished: document.getElementById('editIsPublished').checked,
                isNewProduct: document.getElementById('editIsNewProduct').checked,
                isPopular: document.getElementById('editIsPopular').checked,
                colors: [],
                sizes: [],
                variantInventoryConfigured: Boolean(document.getElementById('variantInventoryConfigured')?.checked),
                variantStocks: variantStockRowsState.map(row => ({ colorId: String(row.colorId || ''), sizeId: String(row.sizeId || ''), countInStock: Math.max(0, Number(row.countInStock || 0)), isOutOfStock: row.isOutOfStock === true })),
                specifications: []
            };
            if (window.OdourProductExtras) Object.assign(data, window.OdourProductExtras.collect());
            
            // جمع‌آوری رنگ‌ها
            document.querySelectorAll('#colorFields > div').forEach((colorDiv) => {
                const nameInput = colorDiv.querySelector('.color-name-input');
                const colorInput = colorDiv.querySelector('input[type="color"]');
                const stockInput = colorDiv.querySelector('.color-stock-input');
                const outOfStockCheckbox = colorDiv.querySelector('.color-out-of-stock-checkbox');
                const imageSelect = colorDiv.querySelector('.color-image-select');
                const imagePreview = colorDiv.querySelector('.color-image-preview');
                
                if (nameInput && colorInput && nameInput.value.trim()) {
                    const colorData = { 
                        name: nameInput.value.trim(), 
                        rgb: colorInput.value 
                    };

                    // شناسه زیرسند رنگ باید در ویرایش حفظ شود تا URL و page_unique ترب تغییر نکند.
                    if (colorDiv.dataset.colorId) {
                        colorData._id = colorDiv.dataset.colorId;
                    }

                    if (stockInput && stockInput.value !== '') {
                        colorData.countInStock = Math.max(0, parseInt(stockInput.value, 10) || 0);
                    }
                    colorData.isOutOfStock = Boolean(outOfStockCheckbox?.checked);
                    
                    // اگر تصویر اختصاصی انتخاب شده
                    if (imageSelect && imageSelect.value) {
                        // پیدا کردن تصویر در previewها
                        const selectedUrl = imageSelect.value;
                        let imageObj = null;
                        
                        // جستجو در تصاویر موجود در preview
                        document.querySelectorAll('#imagePreviews > div').forEach(container => {
                            const img = container.querySelector('img');
                            if (img && (img.src === selectedUrl || img.dataset.url === selectedUrl)) {
                                const captionInput = container.querySelector('.caption-input');
                                imageObj = {
                                    url: selectedUrl,
                                    filename: container.dataset.filename || getFilenameFromUrl(selectedUrl),
                                    caption: captionInput ? captionInput.value.trim() : '',
                                    alt: captionInput ? captionInput.value.trim() : ''
                                };
                            }
                        });
                        
                        // اگر تصویر در preview پیدا نشد، از select استفاده کن
                        if (!imageObj) {
                            const selectedOption = imageSelect.options[imageSelect.selectedIndex];
                            imageObj = {
                                url: selectedUrl,
                                filename: selectedOption.dataset.filename || getFilenameFromUrl(selectedUrl),
                                caption: '',
                                alt: ''
                            };
                        }
                        
                        colorData.image = imageObj;
                    }
                    
                    data.colors.push(colorData);
                }
            });
            
            // جمع‌آوری سایزها
            document.querySelectorAll('#sizeFields > div').forEach((sizeDiv) => {
                const sizeInput = sizeDiv.querySelector('.size-name-input');
                const usageInput = sizeDiv.querySelector('.size-usage-input');
                const stockInput = sizeDiv.querySelector('.size-stock-input');
                const outOfStockCheckbox = sizeDiv.querySelector('.size-out-of-stock-checkbox');
                const size = sizeInput?.value.trim() || '';
                const usage = usageInput?.value.trim() || '';
                if (size) {
                    const sizeData = {
                        size,
                        usage,
                        isOutOfStock: Boolean(outOfStockCheckbox?.checked),
                    };
                    if (sizeDiv.dataset.sizeId) {
                        sizeData._id = sizeDiv.dataset.sizeId;
                    }
                    if (stockInput && stockInput.value !== '') {
                        sizeData.countInStock = Math.max(0, parseInt(stockInput.value, 10) || 0);
                    }
                    data.sizes.push(sizeData);
                }
            });
            
            // جمع‌آوری مشخصات فنی
            document.querySelectorAll('#specFields > div').forEach((specDiv) => {
                const inputs = specDiv.querySelectorAll('input');
                if (inputs.length >= 2) {
                    const key = inputs[0].value.trim();
                    const value = inputs[1].value.trim();
                    if (key && value) {
                        data.specifications.push({ key, value });
                    }
                }
            });
            
            // اعتبارسنجی داده‌ها
            const validationErrors = validateProductData(data);
            
            if (validationErrors.length > 0) {
                showFormErrors(validationErrors);
                return; // توقف ارسال فرم
            }
            
            // نمایش وضعیت در حال ارسال
            const submitBtn = document.querySelector('#form-button');
            const submitBtnIcon = submitBtn?.querySelector('i');
            const submitBtnText = document.getElementById('submitBtnText');
            const originalBtnText = submitBtnText?.textContent || '';
            const originalIconClass = submitBtnIcon?.className || 'fas fa-save ml-2';

            submitBtn.disabled = true;
            if (submitBtnIcon) {
                submitBtnIcon.className = 'fas fa-spinner fa-spin ml-2';
            }
            if (submitBtnText) {
                submitBtnText.textContent = 'در حال ذخیره...';
            }
            
            try {
                const wasEditing = Boolean(currentProductId);
                let response;
                if (currentProductId) {
                    response = await fetch(`/admin/products/edit/${currentProductId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                } else {
                    response = await fetch('/admin/products/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                }
                
                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.message || 'خطا در عملیات');
                }
                
                // به‌روزرسانی لیست محصولات
                if (currentProductId) {
                    const index = products.findIndex(p => p._id === currentProductId);
                    if (index !== -1) {
                        products[index] = result.product;
                    }
                } else {
                    products.unshift(result.product);
                }
                
                loadProducts();
                closeModal('editModal');
                showNotification(
                    wasEditing ? 'محصول با موفقیت ویرایش شد' : 'محصول جدید با موفقیت اضافه شد', 
                    'success'
                );
                
                // ریست فرم در صورت افزودن محصول جدید
                if (!wasEditing) {
                    document.getElementById('editForm').reset();
                    document.getElementById('colorFields').innerHTML = '';
                    document.getElementById('sizeFields').innerHTML = '';
                    document.getElementById('specFields').innerHTML = '';
                    document.getElementById('imagePreviews').innerHTML = '';
                    addColorField();
                    addSizeField();
                    addSpecField();
                }

            } catch (error) {
                console.error('Error:', error);
                showNotification(error.message || 'خطا در عملیات', 'error');
            } finally {
                submitBtn.disabled = false;
                if (submitBtnIcon) {
                    submitBtnIcon.className = originalIconClass;
                }
                if (submitBtnText) {
                    submitBtnText.textContent = originalBtnText;
                }
            }
        });

        document.addEventListener('DOMContentLoaded', () => {            
            // اضافه کردن حداقل یک فیلد برای هر بخش داینامیک
            addColorField();
            addSizeField();
            addSpecField();

            const adminProductSearch = document.getElementById('adminProductSearch');
            if (adminProductSearch) {
                adminProductSearch.addEventListener('input', function() {
                    adminProductSearchQuery = this.value || '';
                    adminProductCurrentPage = 1;
                    loadProducts();
                });
            }
        });

        // Event Listeners
        document.addEventListener('click', function(e) {
            // Close modals when clicking outside
            if (e.target.classList.contains('modal')) {
                e.target.classList.add('hidden');
            }
            
            // Close dropdowns when clicking outside
            const notificationsMenu = document.getElementById('notificationsMenu');
            const profileMenu = document.getElementById('profileMenu');
            
            if (notificationsMenu && !e.target.closest('.fa-bell') && !e.target.closest('#notificationsMenu')) {
                notificationsMenu.classList.add('hidden');
            }
            
            if (profileMenu && !e.target.closest('button[onclick="toggleProfileMenu()"]') && !e.target.closest('#profileMenu')) {
                profileMenu.classList.add('hidden');
            }
        });

        function validateProductData(data) {
            const errors = [];

            // بررسی نام محصول
            if (!data.name || data.name.trim().length === 0) {
                errors.push('نام محصول الزامی است');
            } else if (data.name.trim().length < 3) {
                errors.push('نام محصول نمی‌تواند کمتر از ۳ کاراکتر باشد');
            } else if (data.name.trim().length > 100) {
                errors.push('نام محصول نمی‌تواند بیشتر از ۱۰۰ کاراکتر باشد');
            }

            // بررسی قیمت
            if (data.price === undefined || data.price === null || data.price === '') {
                errors.push('قیمت محصول الزامی است');
            } else if (isNaN(data.price) || data.price < 0) {
                errors.push('قیمت محصول باید عددی مثبت باشد');
            }

            // بررسی قیمت ویژه
            if (data.offerPrice && data.offerPrice > 0) {
                if (isNaN(data.offerPrice) || data.offerPrice < 0) {
                    errors.push('قیمت ویژه باید عددی مثبت باشد');
                }
                if (data.price && data.offerPrice >= data.price) {
                    errors.push('قیمت ویژه باید کمتر از قیمت اصلی باشد');
                }
            }

            // بررسی موجودی
            if (data.countInStock === undefined || data.countInStock === null || data.countInStock === '') {
                errors.push('موجودی محصول الزامی است');
            } else if (isNaN(data.countInStock) || data.countInStock < 0) {
                errors.push('موجودی باید عددی مثبت باشد');
            }


            // بررسی تصاویر
            if (!data.images || data.images.length === 0) {
                errors.push('حداقل یک تصویر برای محصول الزامی است');
            }

            // بررسی دسته‌بندی
            if (!data.category || data.category.length === 0) {
                errors.push('انتخاب دسته‌بندی الزامی است');
            }

            // بررسی برند
            if (!data.brand || data.brand === '') {
                errors.push('انتخاب برند الزامی است');
            }

            return errors;
        }

        function showFormErrors(errors) {
            // حذف خطاهای قبلی
            document.querySelectorAll('.form-error-message').forEach(el => el.remove());
            document.querySelectorAll('.error-border').forEach(el => {
                el.classList.remove('error-border', 'border-red-500', 'bg-red-50');
            });
            
            // نمایش خطاهای جدید
            errors.forEach(error => {
                // نمایش نوتیفیکیشن
                showNotification(error, 'error');
                
                // تشخیص فیلد مربوط به هر خطا و هایلایت کردن آن
                if (error.includes('نام محصول')) {
                    const field = document.getElementById('editName');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('توضیحات')) {
                    const field = document.getElementById('editor');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('قیمت')) {
                    const field = document.getElementById('editPrice');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('موجودی')) {
                    const field = document.getElementById('editCountInStock');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('دسته‌بندی')) {
                    const field = document.getElementById('editCategory');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('برند')) {
                    const field = document.getElementById('editBrand');
                    if (field) highlightErrorField(field, error);
                }
                else if (error.includes('تصویر')) {
                    const field = document.getElementById('editImages');
                    if (field) highlightErrorField(field, error);
                }
            });
        }

        // هایلایت کردن فیلد خطادار
        function highlightErrorField(field, errorMessage) {
            field.classList.add('border-red-500', 'bg-red-50');
            
            // اضافه کردن پیام خطا زیر فیلد
            const errorSpan = document.createElement('p');
            errorSpan.className = 'form-error-message text-red-500 text-xs mt-1';
            errorSpan.textContent = errorMessage;
            field.parentNode.appendChild(errorSpan);
            
            // اسکرول به فیلد خطادار
            field.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // پاک کردن هایلایت خطاها
        function clearFormErrors() {
            document.querySelectorAll('.form-error-message').forEach(el => el.remove());
            document.querySelectorAll('.error-border').forEach(el => {
                el.classList.remove('error-border', 'border-red-500', 'bg-red-50');
            });
        }

        function setupClearErrorsOnInput() {
            const fields = ['editName', 'editPrice', 'editCountInStock', 'editCategory', 'editBrand'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', function() {
                        this.classList.remove('border-red-500', 'bg-red-50');
                        const errorMsg = this.parentNode.querySelector('.form-error-message');
                        if (errorMsg) errorMsg.remove();
                    });
                }
            });
        }

        function showModal(modalId) {
