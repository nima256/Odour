                </div>
                <div class="mt-2">
                    <div class="flex items-center gap-1">
                        <i class="fas fa-pen text-gray-400 text-xs"></i>
                        <input type="text" 
                               class="caption-input w-full text-xs border border-gray-200 rounded px-2 py-1 focus:border-blue-400 focus:outline-none" 
                               value="${escapeHtml(image.caption)}" 
                               placeholder="توضیح تصویر..."
                               data-index="${window.currentWeblogImages.length - 1}">
                    </div>
                </div>
            `;
            previewContainer.appendChild(imgContainer);
            
            // event listener برای ذخیره کپشن
            const captionInput = imgContainer.querySelector('.caption-input');
            captionInput.addEventListener('change', function() {
                const idx = parseInt(this.dataset.index);
                if (window.currentWeblogImages[idx]) {
