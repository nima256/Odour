    <div id="editWeblogModal" class="hidden fixed inset-0 bg-black bg-opacity-50 modal z-50 flex items-center justify-center p-4">
    <div class="glass-card rounded-xl md:rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-4 md:p-6 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg md:text-xl font-bold text-gray-800" id="weblogModalTitle">افزودن مقاله جدید</h3>
            <button onclick="closeModal('editWeblogModal')" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <div class="p-4 md:p-6">
            <form id="weblogForm" class="space-y-4 md:space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                    <div class="md:col-span-2">
                        <label for="weblogTitle" class="block text-sm font-semibold text-gray-700 mb-2">عنوان مقاله <span class="text-red-500">*</span></label>
                        <input type="text" id="weblogTitle" name="title" required
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div class="md:col-span-2">
                        <label for="weblogDescription" class="block text-sm font-semibold text-gray-700 mb-2">توضیحات کوتاه <span class="text-red-500">*</span></label>
                        <textarea id="weblogDescription" name="description" rows="2" required
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
                        <p class="text-xs text-gray-500 mt-1">حداکثر 160 کاراکتر</p>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">تصویر شاخص</label>
                        <input type="file" id="weblogImage" accept="image/*"
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <div id="weblogImagePreview" class="mt-2 hidden">
                            <img id="weblogImagePreviewImg" src="" alt="Preview" class="w-32 h-32 object-cover rounded-lg">
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label for="weblogContent" class="block text-sm font-semibold text-gray-700 mb-2">محتوا <span class="text-red-500">*</span></label>
                        <div id="weblogEditorContainer" class="border border-gray-300 rounded-lg">
                            <div id="weblogEditor" class="min-h-[300px]"></div>
                            <textarea name="content" id="weblogContent" rows="4" required
                                class="hidden"></textarea>
                        </div>
                    </div>

                    <div>
                        <label for="weblogCategories" class="block text-sm font-semibold text-gray-700 mb-2">دسته‌بندی</label>
                        <select id="weblogCategories" multiple
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <!-- Options will be populated from weblog categories -->
                        </select>
                        <p class="text-xs text-gray-500 mt-1">با按住 Ctrl برای انتخاب چندین دسته</p>
                    </div>

                    <div>
                        <label for="weblogTags" class="block text-sm font-semibold text-gray-700 mb-2">برچسب‌ها</label>
                        <input type="text" id="weblogTags" placeholder="با کاما جدا کنید (مثال: مد,پوشاک,کودک)"
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label for="weblogReadingTime" class="block text-sm font-semibold text-gray-700 mb-2">زمان مطالعه (دقیقه)</label>
                        <input type="number" id="weblogReadingTime" min="1" value="5"
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label for="weblogMetaTitle" class="block text-sm font-semibold text-gray-700 mb-2">عنوان متا</label>
                        <input type="text" id="weblogMetaTitle"
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <p class="text-xs text-gray-500 mt-1">حداکثر 60 کاراکتر</p>
                    </div>

                    <div class="md:col-span-2">
                        <label for="weblogMetaDescription" class="block text-sm font-semibold text-gray-700 mb-2">توضیحات متا</label>
                        <textarea id="weblogMetaDescription" rows="2"
                            class="w-full px-3 md:px-4 py-2 md:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
                        <p class="text-xs text-gray-500 mt-1">حداکثر 160 کاراکتر</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center">
                        <input type="checkbox" id="weblogIsFeatured" class="ml-2">
                        <label for="weblogIsFeatured" class="text-sm font-semibold text-gray-700">مقاله ویژه</label>
                    </div>
                    <div class="flex items-center">
                        <input type="checkbox" id="weblogIsPublished" class="ml-2">
                        <label for="weblogIsPublished" class="text-sm font-semibold text-gray-700">منتشر شده</label>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-end space-y-2 sm:space-y-0 sm:space-x-reverse sm:space-x-4 pt-4 md:pt-6 border-t border-gray-200">
                    <button type="button" onclick="closeModal('editWeblogModal')" class="px-4 md:px-6 py-2 md:py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-all">
                        انصراف
                    </button>
                    <button type="submit" id="weblogFormButton" class="px-4 md:px-6 py-2 md:py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">
                        افزودن مقاله
                    </button>
                </div>
            </form>
        </div>
    </div>
