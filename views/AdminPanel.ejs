        function getFilenameFromUrl(url = '') {
            try {
                const parsed = new URL(url, window.location.origin);
                return parsed.pathname.split('/').filter(Boolean).pop() || '';
            } catch (_) {
                return String(url).split('?')[0].split('#')[0].split('/').filter(Boolean).pop() || '';
            }
        }

        function addColorField(name = '', rgb = '#ffffff', imageUrl = '', colorId = '', countInStock = '', isOutOfStock = false) {
            const colorFields = document.getElementById('colorFields');
            const colorField = document.createElement('div');
            colorField.className = 'flex items-center gap-2 flex-wrap p-2 rounded-xl border border-gray-100 bg-gray-50/60';
            colorField.dataset.colorId = colorId || '';
            colorField.innerHTML = `
                <input type="text" placeholder="نام رنگ یا کد رنگ" value="${escapeHtml(name)}"
                    class="flex-1 min-w-[100px] px-3 py-2 border border-gray-300 rounded-lg color-name-input">
                <input type="color" value="${rgb || '#ffffff'}"
                    class="w-10 h-10 border border-gray-300 rounded-lg">
                <input type="number" min="0" placeholder="موجودی رنگ" value="${countInStock === '' ? '' : Number(countInStock)}"
                    title="اگر خالی باشد، موجودی کلی محصول استفاده می‌شود"
                    class="color-stock-input w-28 px-3 py-2 border border-gray-300 rounded-lg text-sm">
                <label class="flex items-center gap-1 text-xs text-gray-600 whitespace-nowrap">
                    <input type="checkbox" class="color-out-of-stock-checkbox" ${isOutOfStock ? 'checked' : ''}>
                    ناموجود
                </label>
                <select class="color-image-select px-2 py-2 border border-gray-300 rounded-lg text-xs flex-1 min-w-[140px]">
                    <option value="">بدون عکس اختصاصی</option>
                </select>
                <img class="color-image-preview w-10 h-10 object-cover rounded-lg border ${imageUrl ? '' : 'hidden'}" src="${imageUrl || ''}">
                <button type="button" onclick="this.parentElement.remove()" class="text-red-500">×</button>
            `;
            colorFields.appendChild(colorField);
        
            const select = colorField.querySelector('.color-image-select');
            const preview = colorField.querySelector('.color-image-preview');
        
            // پر کردن select از عکس‌های آپلودشده فعلی
            populateColorImageSelect(select, imageUrl);
        
            select.addEventListener('change', function() {
                if (this.value) {
                    preview.src = this.value;
                    preview.classList.remove('hidden');
                } else {
                    preview.classList.add('hidden');
                }
            });

            const stockInput = colorField.querySelector('.color-stock-input');
            const unavailableCheckbox = colorField.querySelector('.color-out-of-stock-checkbox');
            const nameInput = colorField.querySelector('.color-name-input');
            stockInput?.addEventListener('input', function() {
                if (this.readOnly) return;
                setAxisStock('colorId', String(colorField.dataset.colorId || ''), this.value);
            });
            unavailableCheckbox?.addEventListener('change', function() {
                setAxisAvailability('colorId', String(colorField.dataset.colorId || ''), this.checked);
            });
            nameInput?.addEventListener('input', refreshVariantInventorySelectors);
        }
        
        // پر کردن select از روی عکس‌های موجود در imagePreviews
        function populateColorImageSelect(selectEl, selectedUrl = '') {
            selectEl.innerHTML = '<option value="">بدون عکس اختصاصی</option>';
            document.querySelectorAll('#imagePreviews > div').forEach(container => {
                const img = container.querySelector('img');
                if (!img) return;
                const url = img.dataset.url || img.getAttribute('src');
                if (!url) return;
                const filename = container.dataset.filename || '';
                const caption = container.dataset.caption || '';
                const opt = document.createElement('option');
                opt.value = url;
                opt.textContent = caption || filename || url.split('/').pop() || 'تصویر';
                opt.dataset.filename = filename;
                if (url === selectedUrl) {
                    opt.selected = true;
                }
                selectEl.appendChild(opt);
            });
        }        
        
