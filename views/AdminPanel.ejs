function enhanceLinksWithTooltip(editorElement) {
    const editor = editorElement.querySelector('.ql-editor');
    if (!editor) return;
    
    // مشاهده تغییرات در ویرایشگر
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === 'childList' || mutation.type === 'subtree') {
                addTooltipsToLinks(editor);
            }
        });
    });
    
    observer.observe(editor, { childList: true, subtree: true });
    addTooltipsToLinks(editor);
}

function addTooltipsToLinks(container) {
    const links = container.querySelectorAll('a');
    links.forEach(link => {
        if (!link.hasAttribute('data-tooltip-enhanced')) {
            const href = link.getAttribute('href');
            const text = link.textContent;
            
            // افزودن title attribute برای tooltip
            if (!link.getAttribute('title')) {
                link.setAttribute('title', `لینک: ${text || href}`);
            }
            
            // افزودن کلاس برای استایل بهتر
            link.classList.add('enhanced-link');
            link.setAttribute('data-tooltip-enhanced', 'true');
            
            // افزودن event listeners
            link.addEventListener('mouseenter', showCustomTooltip);
            link.addEventListener('mouseleave', hideCustomTooltip);
        }
    });
}

function showCustomTooltip(e) {
    const link = e.target;
    const href = link.getAttribute('href');
    const title = link.getAttribute('title') || link.textContent;
    
    // بررسی اگر لینک داخلی یا خارجی است
    const isExternal = href && (href.startsWith('http://') || href.startsWith('https://'));
    const tooltipText = isExternal ? 
        `${title}\nباز کردن در صفحه جدید` : 
        `${title}\n${href}`;
    
    const tooltip = document.createElement('div');
    tooltip.className = 'custom-tooltip';
    tooltip.textContent = tooltipText;
    tooltip.style.cssText = `
        position: fixed;
        background: #333;
        color: #fff;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        z-index: 10000;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        pointer-events: none;
    `;
    
    document.body.appendChild(tooltip);
    
    const rect = link.getBoundingClientRect();
    tooltip.style.top = rect.bottom + 5 + 'px';
    tooltip.style.left = rect.left + 'px';
    
    link._tooltip = tooltip;
}

function hideCustomTooltip(e) {
    if (e.target._tooltip) {
        e.target._tooltip.remove();
        delete e.target._tooltip;
    }
}

// بهبود لینک‌ها در Quill
async function enhanceLinkHandler() {
    const range = window.quillInstance.getSelection();
    if (range) {
        // پرسیدن آدرس لینک
        let url = await showAdminInput({ title: 'افزودن لینک', message: 'آدرس لینک را وارد کنید.', value: 'https://', placeholder: 'https://example.com', inputType: 'url', confirmText: 'ثبت لینک' });
        if (url) {
            // پرسیدن عنوان لینک (tooltip)
            let title = await showAdminInput({ title: 'عنوان لینک', message: 'عنوانی که هنگام قرار گرفتن نشانگر روی لینک نمایش داده شود را وارد کنید.', value: url, placeholder: 'عنوان لینک', confirmText: 'ادامه', cancelText: 'بدون عنوان' });
            
            // ایجاد لینک
            window.quillInstance.formatText(range.index, range.length, 'link', url);
            
            // بعد از ایجاد لینک، title و target را اضافه کن
            setTimeout(() => {
                const editor = document.querySelector('#editor .ql-editor');
                if (editor) {
                    const newLink = editor.querySelector('a[href="' + url + '"]');
                    if (newLink) {
                        if (title && title !== url) {
                            newLink.setAttribute('title', title);
                        } else {
                            newLink.setAttribute('title', 'لینک: ' + url);
                        }
                        // باز شدن در صفحه جدید برای لینک‌های خارجی
                        if (url.startsWith('http://') || url.startsWith('https://')) {
                            newLink.setAttribute('target', '_blank');
                            newLink.setAttribute('rel', 'noopener noreferrer');
                        }
                        newLink.classList.add('enhanced-link');
                    }
                }
            }, 100);
        }
    }
}

function imageHandler() {
    const input = document.createElement('input');
    input.setAttribute('type', 'file');
    input.setAttribute('accept', 'image/*');
    input.click();
    
    input.onchange = async function() {
        const file = input.files[0];
        if (!file) return;
        
        try {
            const range = window.quillInstance.getSelection();
            const placeholderIndex = range ? range.index : 0;
            window.quillInstance.insertEmbed(placeholderIndex, 'image', '/loading.gif');
            
            const formData = new FormData();
            formData.append('image', file);
            
            const response = await fetch('/admin/upload-image', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success && result.url) {
                window.quillInstance.deleteText(placeholderIndex, 1);
                
                // پرسیدن توضیحات از کاربر
                const captionText = await showAdminInput({ title: 'ALT و توضیح تصویر', message: 'برای این تصویر متن جایگزین (ALT) و توضیح مناسب وارد کنید.', placeholder: 'مثلاً: عطر مردانه با رایحه چوبی', hint: 'این متن برای ALT تصویر و توضیح زیر تصویر استفاده می‌شود.', confirmText: 'ثبت توضیح', cancelText: 'بدون توضیح' });
                
                // ساخت کد HTML کامل با figure و figcaption
                let htmlToInsert = `<figure class="image-figure" style="margin: 15px 0; text-align: center;">
                    <img src="${result.url}" alt="${escapeHtml(captionText || '')}" title="${escapeHtml(captionText || '')}" style="max-width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <figcaption class="image-caption" style="font-size: 13px; color: #666; margin-top: 8px; padding: 5px; border-bottom: 1px dashed #ddd; cursor: text; text-align: center;" contenteditable="true">${escapeHtml(captionText || '')}</figcaption>
                </figure>`;
                
                // درج HTML در ویرایشگر
                window.quillInstance.insertEmbed(placeholderIndex, 'html', htmlToInsert);
                
                showNotification('تصویر با موفقیت آپلود شد', 'success');
            } else {
                window.quillInstance.deleteText(placeholderIndex, 1);
                showNotification('خطا در آپلود تصویر', 'error');
            }
        } catch (error) {
            console.error('Error uploading image:', error);
            showNotification('خطا در آپلود تصویر', 'error');
        }
    };
}


        async function uploadWeblogImages(files) {
    if (!files || files.length === 0) return [];
    
    const formData = new FormData();
    for (let i = 0; i < files.length; i++) {
        formData.append('images', files[i]);
    }
    
    try {
        const response = await fetch('/admin/upload-images', {
            method: 'POST',
            body: formData
        });
        
        const result = await response.json();
        
        if (!response.ok) {
            throw new Error(result.error || 'خطا در آپلود تصاویر');
        }
        
        return result.images;
    } catch (error) {
        console.error('Image upload error:', error);
        showNotification('خطا در آپلود تصاویر: ' + error.message, 'error');
        return [];
    }
}

// حذف تصویر مقاله
async function removeWeblogImage(buttonElement, imageUrl, filename) {
    if (!confirm('آیا از حذف این تصویر مطمئن هستید؟')) return;
    
    try {
        const response = await fetch('/admin/delete-image', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename })
        });
        
        const result = await response.json();
        
        if (!response.ok) {
            throw new Error(result.error || 'حذف تصویر انجام نشد');
        }
        
        buttonElement.parentElement.remove();
        showNotification('تصویر با موفقیت حذف شد', 'success');
    } catch (error) {
        console.error('Image deletion error:', error);
        showNotification('خطا در حذف تصویر: ' + error.message, 'error');
    }
}

        // تابع راه‌اندازی ویرایشگر
function initQuillEditor(initialContent = '') {
    if (!window.Quill) return;
    if (window.quillInstance) {
        window.quillInstance.root.innerHTML = initialContent || '';
        return;
    }

    const editorElement = document.getElementById('editor');
    if (!editorElement) {
        console.error('Editor element not found!');
        return;
    }

    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'direction': 'rtl' }],
        [{ 'size': ['small', false, 'large', 'huge'] }],
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'font': [] }],
        [{ 'align': [] }],
        ['clean'],
        ['link', 'image', 'video'],
        [{ 'custom': 'html' }]
    ];

    window.quillInstance = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: {
                container: toolbarOptions,
                handlers: {
                    image: imageHandler,
                    link: async function() {
                        const range = window.quillInstance.getSelection();
                        if (range && range.length > 0) {  // بررسی اینکه متنی انتخاب شده
                            let url = await showAdminInput({ title: 'افزودن لینک', message: 'آدرس لینک را وارد کنید.', value: 'https://', placeholder: 'https://example.com', inputType: 'url', confirmText: 'ثبت لینک' });
                            if (url) {
                                let title = await showAdminInput({ title: 'عنوان لینک', message: 'عنوان لینک اختیاری است؛ در صورت نیاز وارد کنید.', placeholder: 'عنوان لینک (اختیاری)', confirmText: 'ادامه', cancelText: 'بدون عنوان' });
                                
                                // اعمال لینک روی متن انتخاب شده
                                window.quillInstance.formatText(range.index, range.length, 'link', url);
                                
                                // اضافه کردن title و target به لینک ایجاد شده
                                setTimeout(() => {
                                    const editor = document.querySelector('#editor .ql-editor');
                                    if (editor) {
                                        // پیدا کردن آخرین لینک اضافه شده در محدوده انتخاب شده
                                        const links = editor.querySelectorAll('a');
                                        const lastLink = links[links.length - 1];
                                        if (lastLink && lastLink.href === url) {
                                            if (title && title.trim()) {
                                                lastLink.setAttribute('title', title);
                                            } else {
                                                lastLink.setAttribute('title', 'لینک: ' + url);
                                            }
                                            // باز شدن در صفحه جدید برای لینک‌های خارجی
                                            if (url.startsWith('http://') || url.startsWith('https://')) {
                                                lastLink.setAttribute('target', '_blank');
                                                lastLink.setAttribute('rel', 'noopener noreferrer');
                                            }
                                            lastLink.classList.add('enhanced-link');
                                        }
                                    }
                                }, 50);
                            }
                        } else {
                            // اگر متنی انتخاب نشده، پیام خطا نشان بده
                            showNotification('لطفاً ابتدا متنی را که می‌خواهید لینک شود انتخاب کنید', 'error');
                        }
                    },
                    'html': async function() {
                        const range = window.quillInstance.getSelection();
                        if (range) {
                            const htmlCode = await showAdminInput({ title: 'افزودن HTML', message: 'کد HTML موردنظر را وارد کنید.', value: '<figure><img src="" alt=""><figcaption></figcaption></figure>', multiline: true, placeholder: '<div>...</div>', confirmText: 'درج HTML' });
                            if (htmlCode) {
                                window.quillInstance.insertEmbed(range.index, 'html', htmlCode);
                            }
                        }
                    }
                }
            },
            clipboard: {
                matchVisual: false
            }
        },
        placeholder: 'توضیحات محصول را اینجا بنویسید...'
    });
    
    addHeadingShortcuts(window.quillInstance);


    if (initialContent) {
        window.quillInstance.root.innerHTML = initialContent;
    }

    const descriptionField = document.getElementById('editDescription');
    if (descriptionField) {
