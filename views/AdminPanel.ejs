    <script>
    function addHeadingShortcuts(quillInstance) {
    if (!quillInstance || !quillInstance.root) return;
    
    quillInstance.root.addEventListener('keydown', function(e) {
        if (e.shiftKey && e.altKey && !e.ctrlKey) {
            const codeMap = {
                'Digit1': 1, 'Digit2': 2, 'Digit3': 3,
                'Digit4': 4, 'Digit5': 5, 'Digit6': 6,
                'Digit0': false
            };
            
            if (!(e.code in codeMap)) return;
            
            e.preventDefault();
            const range = quillInstance.getSelection();
            
            if (range && range.length > 0) {
                const level = codeMap[e.code];
                const format = quillInstance.getFormat(range);
                quillInstance.format('header', format.header === level ? false : level);
                showNotification(
                    level !== false ? `هدینگ ${level} اعمال شد` : 'متن عادی',
                    'success'
                );
            } else {
                showNotification('ابتدا متنی را انتخاب کنید', 'error');
            }
        }
    });
}
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// دیالوگ داخلی پنل برای جایگزینی prompt/confirm مرورگر در فرم محصول
let adminDialogResolver = null;
let adminDialogMode = 'input';
let adminDialogKeyHandler = null;
let adminDialogHideTimer = null;

function openAdminDialog({
    title = 'ورودی',
    message = '',
    value = '',
    placeholder = '',
    hint = '',
    multiline = false,
    inputType = 'text',
    confirmText = 'تأیید',
    cancelText = 'انصراف',
    danger = false,
    mode = 'input'
} = {}) {
    const modal = document.getElementById('adminDialogModal');
    const card = document.getElementById('adminDialogCard');
    if (adminDialogHideTimer) {
        clearTimeout(adminDialogHideTimer);
        adminDialogHideTimer = null;
    }
    const fieldWrap = document.getElementById('adminDialogFieldWrap');
    const input = document.getElementById('adminDialogInput');
    const textarea = document.getElementById('adminDialogTextarea');
    const hintEl = document.getElementById('adminDialogHint');
    const confirmBtn = document.getElementById('adminDialogConfirmBtn');
    const cancelBtn = document.getElementById('adminDialogCancelBtn');
    const icon = document.getElementById('adminDialogIcon');

    if (!modal || !card || !input || !textarea || !confirmBtn) {
        return Promise.resolve(null);
    }

    // اگر دیالوگ قبلی به هر دلیل باز مانده، آن را بدون مقدار می‌بندیم.
    if (adminDialogResolver) {
        const previousResolver = adminDialogResolver;
        adminDialogResolver = null;
        previousResolver(null);
    }

    adminDialogMode = mode;
    document.getElementById('adminDialogTitle').textContent = title;
    document.getElementById('adminDialogMessage').textContent = message;
    confirmBtn.textContent = confirmText;
    cancelBtn.textContent = cancelText;

    const isConfirm = mode === 'confirm';
    fieldWrap.classList.toggle('hidden', isConfirm);
    input.classList.toggle('hidden', isConfirm || multiline);
    textarea.classList.toggle('hidden', isConfirm || !multiline);

    input.type = inputType || 'text';
    input.value = value ?? '';
    input.placeholder = placeholder || '';
    textarea.value = value ?? '';
    textarea.placeholder = placeholder || '';

    if (hint) {
        hintEl.textContent = hint;
        hintEl.classList.remove('hidden');
    } else {
        hintEl.textContent = '';
        hintEl.classList.add('hidden');
    }

    if (danger) {
        confirmBtn.className = 'px-5 py-2.5 bg-red-600 text-white rounded-xl font-medium hover:bg-red-700 shadow-md transition-all';
        icon.className = 'fas fa-exclamation-triangle';
    } else {
        confirmBtn.className = 'px-5 py-2.5 bg-gradient-to-l from-blue-600 to-indigo-600 text-white rounded-xl font-medium hover:from-blue-700 hover:to-indigo-700 shadow-md transition-all';
        icon.className = isConfirm ? 'fas fa-circle-question' : (multiline ? 'fas fa-code' : 'fas fa-pen');
    }

    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
    });

    adminDialogKeyHandler = (event) => {
        if (event.key === 'Escape') {
            event.preventDefault();
            closeAdminDialog(null);
        } else if (event.key === 'Enter' && !multiline && !isConfirm) {
            event.preventDefault();
            submitAdminDialog();
        } else if (event.key === 'Enter' && isConfirm) {
            event.preventDefault();
            submitAdminDialog();
        }
    };
    document.addEventListener('keydown', adminDialogKeyHandler);

    setTimeout(() => {
        if (!isConfirm) {
            const activeField = multiline ? textarea : input;
            activeField.focus();
            if (typeof activeField.select === 'function') activeField.select();
        } else {
            confirmBtn.focus();
        }
    }, 80);

    return new Promise(resolve => {
        adminDialogResolver = resolve;
    });
}

function closeAdminDialog(value = null) {
    const modal = document.getElementById('adminDialogModal');
    const card = document.getElementById('adminDialogCard');
    const resolver = adminDialogResolver;
    adminDialogResolver = null;

    if (adminDialogKeyHandler) {
        document.removeEventListener('keydown', adminDialogKeyHandler);
        adminDialogKeyHandler = null;
    }

    if (card) {
        card.classList.remove('scale-100', 'opacity-100');
        card.classList.add('scale-95', 'opacity-0');
    }
    if (modal) {
        adminDialogHideTimer = setTimeout(() => {
            modal.classList.add('hidden');
            adminDialogHideTimer = null;
        }, 150);
    }

    if (resolver) resolver(value);
}

function submitAdminDialog() {
    if (adminDialogMode === 'confirm') {
        closeAdminDialog(true);
        return;
    }

    const input = document.getElementById('adminDialogInput');
    const textarea = document.getElementById('adminDialogTextarea');
    const value = textarea && !textarea.classList.contains('hidden') ? textarea.value : input.value;
    closeAdminDialog(value);
}

function showAdminInput(options = {}) {
    return openAdminDialog({ ...options, mode: 'input' });
}

function showAdminConfirm(options = {}) {
    return openAdminDialog({ ...options, mode: 'confirm' });
}


