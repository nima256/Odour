// لود کردن لیست دسته‌بندی‌ها برای مدیریت
function loadCategoryManagerList() {
    const container = document.getElementById('categoryManagerList');
    if (!container) return;
    
    container.innerHTML = '<div class="text-center py-4 text-gray-500">در حال بارگذاری...</div>';
    
    fetch('/admin/categories')
        .then(res => res.json())
        .then(data => {
            if (data.success && data.categories) {
                renderCategoryList(data.categories);
            } else {
                container.innerHTML = '<div class="text-center py-4 text-red-500">خطا در بارگذاری</div>';
            }
        })
        .catch(err => {
            console.error('Error loading categories:', err);
            container.innerHTML = '<div class="text-center py-4 text-red-500">خطا در بارگذاری</div>';
        });
}

function renderCategoryList(categories) {
    const container = document.getElementById('categoryManagerList');
    if (!container) return;
    
    // مرتب‌سازی دسته‌بندی‌ها
    const sortedCategories = [...categories].sort((a, b) => a.name.localeCompare(b.name));
    
    container.innerHTML = '';
    
    // تابع بازگشتی برای نمایش دسته‌بندی‌های تو در تو
    function renderCategoryTree(cats, level = 0) {
        cats.forEach(cat => {
            const item = document.createElement('div');
            item.className = `category-manager-item p-3 rounded-lg mb-2 ${level > 0 ? 'mr-4' : ''}`;
            item.style.paddingRight = `${12 + (level * 16)}px`;
            item.innerHTML = `
                <div class="flex justify-between items-center">
                    <span class="font-medium">${cat.name}</span>
                    <span class="text-xs ${cat.description ? 'text-green-500' : 'text-gray-400'}">
                        ${cat.description ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-edit"></i>'}
                    </span>
                </div>
            `;
            item.dataset.id = cat._id;
            item.dataset.name = cat.name;
            item.dataset.description = cat.description || '';
            item.onclick = () => selectCategoryForEdit(cat._id, cat.name, cat.description || '');
            container.appendChild(item);
            
            // نمایش فرزندان
            if (cat.children && cat.children.length > 0) {
                renderCategoryTree(cat.children, level + 1);
            }
        });
    }
    
    // ساختار درختی
    const categoryMap = {};
    sortedCategories.forEach(cat => {
        categoryMap[cat._id] = { ...cat, children: [] };
    });
    
    const rootCategories = [];
    sortedCategories.forEach(cat => {
        if (cat.parentId && categoryMap[cat.parentId]) {
            categoryMap[cat.parentId].children.push(categoryMap[cat._id]);
        } else if (!cat.parentId) {
            rootCategories.push(categoryMap[cat._id]);
        }
    });
    
    renderCategoryTree(rootCategories);
}

// انتخاب دسته‌بندی برای ویرایش
async function selectCategoryForEdit(categoryId, categoryName, currentDescription) {
    currentSelectedCategory = categoryId;

    // حذف حالت active از همه دسته‌ها
    document.querySelectorAll('.category-manager-item').forEach(item => {
        item.classList.remove(
            'active',
            'bg-gradient-to-r',
            'from-blue-600',
            'to-indigo-600',
            'text-white'
        );
    });

    // فعال کردن دسته انتخاب شده
    const selectedItem = document.querySelector(
        `.category-manager-item[data-id="${categoryId}"]`
    );

    if (selectedItem) {
        selectedItem.classList.add(
            'active',
            'bg-gradient-to-r',
            'from-blue-600',
            'to-indigo-600',
            'text-white'
        );
    }

    // نمایش پنل ویرایش
    document.getElementById('selectedCategoryName').textContent = categoryName;
    document.getElementById('categoryEditorPanel').classList.remove('hidden');
    document.getElementById('categoryNoSelection').classList.add('hidden');

    try {
        const response = await fetch(`/admin/api/category-description/${categoryId}`);
        const data = await response.json();

        const description = data.success
            ? (data.description || '')
            : (currentDescription || '');

        const metaDescription = data.success
            ? (data.metaDescription || '')
            : '';

        // مقداردهی Quill
        if (categoryDescQuill) {
            categoryDescQuill.root.innerHTML = description;
        } else {
            initCategoryDescQuill(description);
        }

        // فیلد hidden برای ذخیره
        const descValue = document.getElementById('categoryDescValue');
        if (descValue) {
            descValue.value = description;
        }

        // مقداردهی Meta Description
        const metaDescField = document.getElementById('categoryMetaDesc');
        if (metaDescField) {
            metaDescField.value = metaDescription;
        }

        // شمارنده کاراکتر
        const metaDescCount = document.getElementById('metaDescCount');
        if (metaDescCount) {
            metaDescCount.textContent = `${metaDescription.length}/160`;
        }

    } catch (error) {
        console.error('Error loading category data:', error);

        // fallback
        if (categoryDescQuill) {
            categoryDescQuill.root.innerHTML = currentDescription || '';
        } else {
            initCategoryDescQuill(currentDescription || '');
        }

        const descValue = document.getElementById('categoryDescValue');
        if (descValue) {
            descValue.value = currentDescription || '';
        }
    }
}
// مقداردهی ویرایشگر Quill برای دسته‌بندی
function initCategoryDescQuill(initialContent = '') {
    if (!window.Quill) return;
    if (categoryDescQuill) {
        categoryDescQuill.root.innerHTML = initialContent;
        return;
    }
    
    const editorElement = document.getElementById('categoryDescEditor');
    if (!editorElement) return;
    
    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'script': 'sub'}, { 'script': 'super' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'direction': 'rtl' }],
        [{ 'size': ['small', false, 'large', 'huge'] }],
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'font': [] }],
        [{ 'align': [] }],
        ['clean'],
        ['link', 'image', 'video'],
        [{ 'custom': 'html' }]
    ];
    
    categoryDescQuill = new Quill('#categoryDescEditor', {
        theme: 'snow',
        modules: {
            toolbar: {
                container: toolbarOptions,
                handlers: {
                    image: categoryDescImageHandler,
                    link: function() {
                        const range = weblogQuillEditor.getSelection();
                        if (range) {
                            let url = prompt('لطفاً آدرس لینک را وارد کنید:', 'https://');
                            if (url) {
                                let title = prompt('لطفاً عنوان لینک را وارد کنید:', url);
                                weblogQuillEditor.format('link', url);
                                setTimeout(() => {
                                    const editor = document.querySelector('#weblogEditor .ql-editor');
                                    if (editor) {
                                        const newLink = editor.querySelector('a[href="' + url + '"]');
                                        if (newLink) {
                                            if (title && title !== url) {
                                                newLink.setAttribute('title', title);
                                            }
                                            if (url.startsWith('http')) {
                                                newLink.setAttribute('target', '_blank');
                                                newLink.setAttribute('rel', 'noopener noreferrer');
                                            }
                                            newLink.classList.add('enhanced-link');
                                        }
                                    }
                                }, 100);
                            }
                        }
                    },
                    'html': function() {
                        const range = window.quillInstance.getSelection();
                        if (range) {
                            const htmlCode = prompt('کد HTML خود را وارد کنید:', '<figure><img src="" alt=""><figcaption></figcaption></figure>');
                            if (htmlCode) {
                                window.quillInstance.insertEmbed(range.index, 'html', htmlCode);
                            }
                        }
                    }
                }
            }
        },
        placeholder: 'توضیحات دسته‌بندی را اینجا بنویسید...'
    });
    
    addHeadingShortcuts(categoryDescQuill);
    
    if (initialContent) {
        categoryDescQuill.root.innerHTML = initialContent;
    }
    
    const descField = document.getElementById('categoryDescValue');
    if (descField) {
        categoryDescQuill.on('text-change', function() {
            descField.value = categoryDescQuill.root.innerHTML;
        });
    }
    
    const editorContainer = document.querySelector('#categoryDescEditor .ql-editor');
    if (editorContainer) {
        editorContainer.style.direction = 'rtl';
        editorContainer.style.textAlign = 'right';
    }
}

// هندلر آپلود تصویر برای ویرایشگر دسته‌بندی
function categoryDescImageHandler() {
    const input = document.createElement('input');
    input.setAttribute('type', 'file');
    input.setAttribute('accept', 'image/*');
    input.click();
    
    input.onchange = async function() {
        const file = input.files[0];
        if (!file) return;
        
        try {
            const range = categoryDescQuill.getSelection();
            const placeholderIndex = range.index;
            categoryDescQuill.insertEmbed(placeholderIndex, 'image', '/loading.gif');
            
            const formData = new FormData();
            formData.append('image', file);
            
            const response = await fetch('/admin/upload-image', {
                method: 'POST',
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success && result.url) {
                categoryDescQuill.deleteText(placeholderIndex, 1);
                categoryDescQuill.insertEmbed(placeholderIndex, 'image', result.url);
            } else {
                categoryDescQuill.deleteText(placeholderIndex, 1);
                console.error('Image upload failed:', result.error);
            }
        } catch (error) {
            console.error('Error uploading image:', error);
        }
    };
}

