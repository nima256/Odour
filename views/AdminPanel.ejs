                    <div class="adm-card__body">
                        <p class="adm-kpi__value adm-num" style="font-size:1.6rem"><%= _fa(_d.banners.active) %><small>از <%= _fa(_d.banners.total) %> بنر</small></p>
                        <p class="adm-note">بنرهای غیرفعال یا خارج از بازه‌ی زمانی در فروشگاه نمایش داده نمی‌شوند.</p>
                    </div>
                </section>
            </div>

            <details class="adm-card adm-details">
                <summary>آمار بازدید سایت <%- icon('chevron-down', 'od-icon--sm') %></summary>
                <div class="adm-card__body" style="padding-top:0">
                    <div class="adm-pipeline" style="margin-bottom:14px">
                        <div><span>کل بازدیدها</span><strong class="adm-num"><%= _fa(visitStats.totalVisits) %></strong></div>
                        <div><span>امروز</span><strong class="adm-num"><%= _fa(visitStats.todayVisits) %></strong></div>
                        <div><span>دیروز</span><strong class="adm-num"><%= _fa(visitStats.yesterdayVisits) %></strong></div>
                    </div>
                    <% if (visitStats.topPages && visitStats.topPages.length) { %>
                        <h4 style="font-size:13px;font-weight:700;margin-bottom:6px">پربازدیدترین صفحات (۳۰ روز اخیر)</h4>
                        <div class="adm-list">
                            <% visitStats.topPages.forEach(function (page, index) { %>
                                <div class="adm-list__row">
                                    <span class="adm-pill adm-num"><%= _fa(index + 1) %></span>
                                    <div class="adm-list__main"><a href="<%= page.link %>" target="_blank" rel="noopener"><strong><%= page.displayName %></strong></a></div>
                                    <strong class="adm-num"><%= _fa(page.count) %></strong>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="adm-empty">هنوز بازدیدی ثبت نشده است.</p>
                    <% } %>
                </div>
            </details>
        </div>

        <!-- Banners -->
        <div id="bannersContent" class="hidden">
            <div class="adm-page-head">
