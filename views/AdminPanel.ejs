document.getElementById('weblogForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    if (weblogQuillEditor) {
        document.getElementById('weblogContent').value = weblogQuillEditor.root.innerHTML;
    }
    
    // جمع‌آوری تصاویر موجود (که در preview هستند)
    const existingImages = [];
    const previewContainer = document.getElementById('weblogImagePreviews');
    if (previewContainer) {
        const items = previewContainer.querySelectorAll('.relative.group');
        items.forEach((item) => {
            const img = item.querySelector('img');
            const captionInput = item.querySelector('.caption-input');
            const filename = item.dataset.filename;
            if (img && img.src) {
                existingImages.push({
                    url: img.src,
                    filename: filename,
                    caption: captionInput ? captionInput.value.trim() : (item.dataset.caption || ''),
                    alt: captionInput ? captionInput.value.trim() : (item.dataset.caption || '')
                });
            }
        });
    }
    
    // آپلود تصاویر جدید با کپشن
    const fileInput = document.getElementById('weblogImages');
    let newImages = [];
    if (fileInput && fileInput.files.length > 0) {
        const filesArray = Array.from(fileInput.files);
        newImages = await uploadWeblogImagesWithCaption(filesArray);
    }
    
    // ترکیب تصاویر موجود و جدید
    const allImages = [...existingImages, ...newImages];
    
    const data = {
        title: document.getElementById('weblogTitle').value.trim(),
        description: document.getElementById('weblogDescription').value.trim(),
        content: document.getElementById('weblogContent').value,
        images: allImages.map(img => ({
            url: img.url,
            filename: img.filename,
            alt: img.caption || '',
            title: img.caption || ''
        })),
        categories: Array.from(document.getElementById('weblogCategories').selectedOptions).map(opt => opt.value),
        tags: document.getElementById('weblogTags').value ? document.getElementById('weblogTags').value.split(',').map(t => t.trim()).filter(t => t) : [],
        readingTime: parseInt(document.getElementById('weblogReadingTime').value),
        isFeatured: document.getElementById('weblogIsFeatured').checked,
        isPublished: document.getElementById('weblogIsPublished').checked,
        metaTitle: document.getElementById('weblogMetaTitle').value,
        metaDescription: document.getElementById('weblogMetaDescription').value
    };
    
    // اعتبارسنجی
    if (!data.title || data.title.trim().length === 0) {
        showNotification('عنوان مقاله الزامی است', 'error');
        return;
    }
    
    if (!data.content || data.content.trim().length === 0) {
        showNotification('محتوای مقاله الزامی است', 'error');
        return;
    }
    
    try {
        let response;
        
        if (currentWeblogId) {
            response = await fetch(`/admin/weblogs/edit/${currentWeblogId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
        } else {
            response = await fetch('/admin/weblogs/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
        }
        
        const result = await response.json();
        
        if (!response.ok) {
            throw new Error(result.message || 'خطا در ذخیره مقاله');
        }
        
        if (currentWeblogId) {
            const index = weblogs.findIndex(w => w._id === currentWeblogId);
            if (index !== -1) {
                weblogs[index] = result.weblog;
            }
        } else {
            weblogs.unshift(result.weblog);
        }
        
        renderWeblogsTable();
        closeModal('editWeblogModal');
        showNotification(currentWeblogId ? 'مقاله با موفقیت ویرایش شد' : 'مقاله جدید با موفقیت اضافه شد', 'success');

        setTimeout(() => {
            location.reload();
        }, 500);
        
    } catch (error) {
        console.error('Error saving weblog:', error);
        showNotification(error.message || 'خطا در ذخیره مقاله', 'error');
    }
});

