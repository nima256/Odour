        async function saveDiscount(e) {
            e.preventDefault();
            
            const type = document.getElementById('discountType').value;
            const amount = parseFloat(document.getElementById('discountAmount').value);
            
            const data = {
                code: document.getElementById('discountCode').value.trim().toUpperCase(),
                type: type,
                amount: amount,
                minOrderAmount: document.getElementById('minOrderAmount').value ? parseFloat(document.getElementById('minOrderAmount').value) : null,
                usageLimit: document.getElementById('usageLimit').value ? parseInt(document.getElementById('usageLimit').value) : null,
                expireDate: document.getElementById('expireDate').value || null,
                isActive: document.getElementById('isActive').checked,
                description: document.getElementById('description').value || null,
                oneTimePerUser: document.getElementById('oneTimePerUser').checked,
            };
            
            // اضافه کردن maxDiscountAmount برای تخفیف درصدی
            if (type === 'percent') {
                const maxDiscountAmount = document.getElementById('maxDiscountAmount').value;
                if (!maxDiscountAmount) {
                    showNotification('برای تخفیف درصدی، سقف تخفیف الزامی است', 'error');
                    return;
                }
                data.maxDiscountAmount = parseFloat(maxDiscountAmount);
            }
            
            // اعتبارسنجی
            if (!data.code) {
                showNotification('کد تخفیف الزامی است', 'error');
                return;
            }
            
            if (!data.code.match(/^[A-Z0-9]+$/)) {
                showNotification('کد تخفیف باید فقط شامل حروف انگلیسی و اعداد باشد', 'error');
                return;
            }
            
            if (data.code.length < 5 || data.code.length > 20) {
                showNotification('کد تخفیف باید بین 5 تا 20 کاراکتر باشد', 'error');
                return;
            }
            
            if (!amount || amount <= 0) {
                showNotification('مقدار تخفیف باید بیشتر از صفر باشد', 'error');
                return;
            }
            
            if (type === 'percent' && amount > 100) {
                showNotification('تخفیف درصدی نمی‌تواند بیشتر از ۱۰۰ باشد', 'error');
                return;
            }
            
            try {
                let response;
                
                if (isEditing && currentEditItem) {
                    response = await fetch(`/admin/discounts/edit/${currentEditItem}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                } else {
                    response = await fetch('/admin/discounts/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                }
                
                const result = await response.json();
                
                if (!response.ok) {
                    throw new Error(result.message || 'خطا در ذخیره تخفیف');
                }
                
                // به‌روزرسانی لیست محلی
                if (isEditing && currentEditItem) {
                    const index = discounts.findIndex(d => d.id === currentEditItem);
                    if (index !== -1) {
                        discounts[index] = result.discount;
                    }
                } else {
                    discounts.unshift(result.discount);
                }
                
                loadDiscounts();
                closeDiscountModal();
