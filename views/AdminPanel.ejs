function saveActiveSection(sectionName) {
    localStorage.setItem('adminActiveSection', sectionName);
}

// تابع برای بارگذاری بخش فعال از localStorage
function loadActiveSection() {
    const savedSection = localStorage.getItem('adminActiveSection');
    if (savedSection && savedSection !== 'dashboard') {
        // اگر بخش ذخیره شده وجود داشت و داشبورد نبود، اون رو نمایش بده
        showSection(savedSection);
    } else {
        // در غیر این صورت داشبورد رو نشون بده
        showSection('dashboard');
    }
}

// تابع showSection رو تغییر بده تا بخش فعال رو ذخیره کنه
const originalShowSection = showSection;
window.showSection = function(section) {
    // ذخیره کردن در localStorage
    saveActiveSection(section);
    // اجرای تابع اصلی
    originalShowSection(section);
}

// وقتی صفحه لود شد، بخش ذخیره شده رو بارگذاری کن
document.addEventListener('DOMContentLoaded', function() {
    // ابتدا بخش‌ها رو پنهان کن (برای جلوگیری از چشمک زدن)
    const sections = ADMIN_SECTIONS;
    sections.forEach(section => {
        const content = document.getElementById(section + 'Content');
        if (content) content.classList.add('hidden');
    });
    
    // بعد از اینکه همه چیز آماده شد، بخش ذخیره شده رو نشون بده
    setTimeout(() => {
        loadActiveSection();
        
        // اگر در URL هش وجود داشت، اولویت با هش هست
        if (window.location.hash) {
            const hashSection = window.location.hash.substring(1);
            if (sections.includes(hashSection)) {
                showSection(hashSection);
            }
        }
    }, 100);
    
    // بقیه کدهای DOMContentLoaded قبلی‌ات رو همینجا نگه دار...
});

document.addEventListener('DOMContentLoaded', function() {
    document.body.addEventListener('input', function(e) {
        if (e.target.id === 'categoryMetaDesc') {
