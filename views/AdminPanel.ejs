        let categories = <%- JSON.stringify(categories).replace(/</g, '\\u003c') %>;
        let brands = <%- JSON.stringify(brands).replace(/</g, '\\u003c') %>;
        let discounts = <%- JSON.stringify(discounts).replace(/</g, '\\u003c') %>;


        let currentProductId = null;
        let currentProduct = {};
        let variantStockRowsState = [];

        function getCurrentVariantOptions() {
            const colors = Array.from(document.querySelectorAll('#colorFields > div'))
                .map(div => ({
                    id: String(div.dataset.colorId || ''),
                    label: div.querySelector('.color-name-input')?.value.trim() || ''
                }))
                .filter(x => x.label);
            const sizes = Array.from(document.querySelectorAll('#sizeFields > div'))
                .map(div => ({
                    id: String(div.dataset.sizeId || ''),
                    label: div.querySelector('.size-name-input')?.value.trim() || ''
                }))
                .filter(x => x.label);
            return { colors, sizes };
        }

        function refreshVariantInventorySelectors() {
            const { colors, sizes } = getCurrentVariantOptions();
            const colorSelect = document.getElementById('variantColorSelect');
            const sizeSelect = document.getElementById('variantSizeSelect');
            if (!colorSelect || !sizeSelect) return;
            colorSelect.innerHTML = colors.length
                ? colors.map(c => `<option value="${escapeHtml(c.id)}" ${!c.id ? 'disabled' : ''}>${escapeHtml(c.label)}${!c.id ? ' (ابتدا ذخیره شود)' : ''}</option>`).join('')
                : '<option value="">بدون رنگ</option>';
            sizeSelect.innerHTML = sizes.length
                ? sizes.map(s => `<option value="${escapeHtml(s.id)}" ${!s.id ? 'disabled' : ''}>${escapeHtml(s.label)}${!s.id ? ' (ابتدا ذخیره شود)' : ''}</option>`).join('')
                : '<option value="">بدون سایز</option>';
        }

        function variantLabelById(type, id) {
            const options = getCurrentVariantOptions()[type];
            if (!id) return type === 'colors' ? 'بدون رنگ' : 'بدون سایز';
            return options.find(x => x.id === String(id))?.label || String(id);
        }

        function variantRowKey(colorId = '', sizeId = '') {
            return `${String(colorId || '') || '-'}|${String(sizeId || '') || '-'}`;
        }

        function variantMatrixConfiguredInForm() {
            return Boolean(document.getElementById('variantInventoryConfigured')?.checked);
        }

        function totalVariantStockInForm() {
            return variantStockRowsState.reduce((sum, row) => sum + Math.max(0, Number(row.countInStock || 0)), 0);
        }

        function matchingVariantRows(axis, id) {
            const value = String(id || '');
            return variantStockRowsState.filter(row => String(row[axis] || '') === value);
        }

        function syncMainStockFromMatrix() {
            const input = document.getElementById('editCountInStock');
            const help = document.getElementById('editCountInStockHelp');
            if (!input) return;

            if (!variantMatrixConfiguredInForm()) {
                input.readOnly = false;
                input.classList.remove('bg-gray-100', 'cursor-not-allowed');
                if (help) help.textContent = 'برای محصولات قدیمی، موجودی کلی مستقیماً قابل ویرایش است.';
                return;
            }

            const total = totalVariantStockInForm();
            input.value = total;
            if (variantStockRowsState.length <= 1) {
                input.readOnly = false;
                input.classList.remove('bg-gray-100', 'cursor-not-allowed');
                if (help) help.textContent = 'این محصول یک تنوع دارد؛ تغییر این عدد همان موجودی دقیق تنوع را تغییر می‌دهد.';
            } else {
                input.readOnly = true;
                input.classList.add('bg-gray-100', 'cursor-not-allowed');
                if (help) help.textContent = 'این محصول چند تنوع دارد؛ موجودی کل از جمع جدول رنگ × سایز محاسبه می‌شود.';
            }
        }

        function syncLegacyVariantControlsFromMatrix() {
            if (!variantMatrixConfiguredInForm()) return;
            const { colors, sizes } = getCurrentVariantOptions();

            document.querySelectorAll('#colorFields > div').forEach((div) => {
                const colorId = String(div.dataset.colorId || '');
                const rows = matchingVariantRows('colorId', colorId);
                const stockInput = div.querySelector('.color-stock-input');
                const checkbox = div.querySelector('.color-out-of-stock-checkbox');
                if (stockInput) {
                    stockInput.value = rows.reduce((sum, row) => sum + Math.max(0, Number(row.countInStock || 0)), 0);
                    stockInput.readOnly = sizes.length > 0 || !colorId;
                    stockInput.classList.toggle('bg-gray-100', stockInput.readOnly);
                    stockInput.title = stockInput.readOnly
                        ? 'برای محصول رنگ × سایز، موجودی را از جدول ترکیب‌ها تغییر دهید.'
                        : 'موجودی همین رنگ؛ با جدول موجودی دقیق همگام است.';
                }
                if (checkbox) {
                    checkbox.checked = rows.length > 0 && rows.every(row => row.isOutOfStock === true);
                    checkbox.disabled = rows.length === 0;
                    checkbox.title = rows.length
                        ? 'با فعال کردن، تمام ترکیب‌های این رنگ موقتاً ناموجود می‌شوند.'
                        : 'برای این رنگ ترکیب عرضه‌شده‌ای ثبت نشده است.';
                }
            });

            document.querySelectorAll('#sizeFields > div').forEach((div) => {
                const sizeId = String(div.dataset.sizeId || '');
                const rows = matchingVariantRows('sizeId', sizeId);
                const stockInput = div.querySelector('.size-stock-input');
                const checkbox = div.querySelector('.size-out-of-stock-checkbox');
                if (stockInput) {
                    stockInput.value = rows.reduce((sum, row) => sum + Math.max(0, Number(row.countInStock || 0)), 0);
                    stockInput.readOnly = colors.length > 0 || !sizeId;
                    stockInput.classList.toggle('bg-gray-100', stockInput.readOnly);
                    stockInput.title = stockInput.readOnly
                        ? 'برای محصول رنگ × سایز، موجودی را از جدول ترکیب‌ها تغییر دهید.'
                        : 'موجودی همین سایز؛ با جدول موجودی دقیق همگام است.';
                }
                if (checkbox) {
                    checkbox.checked = rows.length > 0 && rows.every(row => row.isOutOfStock === true);
                    checkbox.disabled = rows.length === 0;
                    checkbox.title = rows.length
                        ? 'با فعال کردن، تمام ترکیب‌های این سایز موقتاً ناموجود می‌شوند.'
                        : 'برای این سایز ترکیب عرضه‌شده‌ای ثبت نشده است.';
                }
            });
        }

        function syncInventoryUiFromMatrix() {
            syncMainStockFromMatrix();
            syncLegacyVariantControlsFromMatrix();
        }

        function setAxisAvailability(axis, id, checked) {
            if (!variantMatrixConfiguredInForm()) return;
            const rows = matchingVariantRows(axis, id);
            rows.forEach(row => { row.isOutOfStock = Boolean(checked); });
            renderVariantStockRows();
        }

        function setAxisStock(axis, id, value) {
            if (!variantMatrixConfiguredInForm()) return;
            const rows = matchingVariantRows(axis, id);
            // این مسیر فقط برای تک‌بعدی‌ها فعال است؛ در چندبعدی input به صورت readOnly نمایش داده می‌شود.
            if (rows.length !== 1) return;
            rows[0].countInStock = Math.max(0, parseInt(value || '0', 10) || 0);
            renderVariantStockRows();
        }

        function renderVariantStockRows() {
            refreshVariantInventorySelectors();
            const tbody = document.getElementById('variantStockRows');
            if (!tbody) return;
            if (!variantStockRowsState.length) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-400">هنوز ترکیبی ثبت نشده است.</td></tr>';
                syncInventoryUiFromMatrix();
                return;
            }
            tbody.innerHTML = variantStockRowsState.map((row, index) => `
                <tr class="border-t border-gray-100">
                    <td class="p-2">${escapeHtml(variantLabelById('colors', row.colorId))}</td>
                    <td class="p-2">${escapeHtml(variantLabelById('sizes', row.sizeId))}</td>
                    <td class="p-2"><input type="number" min="0" value="${Number(row.countInStock || 0)}" onchange="updateVariantStockRow(${index}, this.value)" class="w-24 px-2 py-1 border border-gray-300 rounded"></td>
                    <td class="p-2 text-center"><input type="checkbox" ${row.isOutOfStock === true ? 'checked' : ''} onchange="updateVariantAvailability(${index}, this.checked)" title="فروش این ترکیب را موقتاً ببند"></td>
                    <td class="p-2 text-center"><button type="button" onclick="removeVariantStockRow(${index})" class="text-red-600 hover:text-red-800">حذف</button></td>
                </tr>`).join('');
            syncInventoryUiFromMatrix();
        }

        function addVariantStockRow() {
            if (!currentProductId) {
                showNotification('ابتدا محصول را ذخیره کنید، سپس موجودی رنگ × سایز را در ویرایش محصول ثبت کنید.', 'warning');
                return;
            }
            refreshVariantInventorySelectors();
            const colorId = String(document.getElementById('variantColorSelect')?.value || '');
            const sizeId = String(document.getElementById('variantSizeSelect')?.value || '');
            const countInStock = Math.max(0, parseInt(document.getElementById('variantStockInput')?.value || '0', 10) || 0);
            const { colors, sizes } = getCurrentVariantOptions();
            if (colors.length && !colorId) return showNotification('یک رنگ ذخیره‌شده انتخاب کنید.', 'warning');
            if (sizes.length && !sizeId) return showNotification('یک سایز ذخیره‌شده انتخاب کنید.', 'warning');
            const existing = variantStockRowsState.find(r => String(r.colorId || '') === colorId && String(r.sizeId || '') === sizeId);
            if (existing) existing.countInStock = countInStock;
            else variantStockRowsState.push({ colorId, sizeId, countInStock, isOutOfStock: false });
            document.getElementById('variantInventoryConfigured').checked = true;
            renderVariantStockRows();
        }

        function updateVariantStockRow(index, value) {
            if (!variantStockRowsState[index]) return;
            variantStockRowsState[index].countInStock = Math.max(0, parseInt(value || '0', 10) || 0);
            syncInventoryUiFromMatrix();
        }

        function updateVariantAvailability(index, checked) {
            if (!variantStockRowsState[index]) return;
            variantStockRowsState[index].isOutOfStock = Boolean(checked);
            syncInventoryUiFromMatrix();
        }

        function removeVariantStockRow(index) {
            variantStockRowsState.splice(index, 1);
            renderVariantStockRows();
        }

        function loadVariantInventory(product) {
            const configured = product?.variantInventoryConfigured === true;
            const checkbox = document.getElementById('variantInventoryConfigured');
            if (checkbox) {
                checkbox.checked = configured;
                checkbox.disabled = configured && Boolean(currentProductId);
                checkbox.title = checkbox.disabled
                    ? 'این محصول به موجودی دقیق مهاجرت کرده و برای جلوگیری از خراب شدن سفارش‌ها قابل بازگشت به حالت قدیمی نیست.'
                    : '';
            }
            variantStockRowsState = Array.isArray(product?.variantStocks)
                ? product.variantStocks.map(row => ({
                    colorId: String(row.colorId || ''),
                    sizeId: String(row.sizeId || ''),
                    countInStock: Math.max(0, Number(row.countInStock || 0)),
                    isOutOfStock: row.isOutOfStock === true,
                }))
                : [];
            const note = document.getElementById('variantInventoryNewProductNote');
            if (note) note.classList.toggle('hidden', Boolean(currentProductId));

            const mainStockInput = document.getElementById('editCountInStock');
            if (mainStockInput && mainStockInput.dataset.variantSyncBound !== '1') {
                mainStockInput.dataset.variantSyncBound = '1';
                mainStockInput.addEventListener('input', function() {
                    if (!variantMatrixConfiguredInForm() || this.readOnly || variantStockRowsState.length !== 1) return;
                    variantStockRowsState[0].countInStock = Math.max(0, parseInt(this.value || '0', 10) || 0);
                    renderVariantStockRows();
                });
            }
            if (checkbox && checkbox.dataset.variantSyncBound !== '1') {
                checkbox.dataset.variantSyncBound = '1';
                checkbox.addEventListener('change', syncInventoryUiFromMatrix);
            }
            renderVariantStockRows();
        }

