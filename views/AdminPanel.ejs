                        <div class="adm-card__body">
                            <% if (!_d.stock.lowList.length) { %>
                                <p class="adm-empty">موجودی همه‌ی محصولات بالاتر از حد هشدار است.</p>
                            <% } else { %>
                                <div class="adm-list">
                                    <% _d.stock.lowList.forEach(function (p) { %>
                                        <div class="adm-list__row">
                                            <img class="adm-list__thumb" src="<%= (p.images && p.images[0] && p.images[0].url) || '/logo.webp' %>" alt="" loading="lazy" width="42" height="42">
                                            <div class="adm-list__main"><strong><%= p.name %></strong><span><%= p.sku || '' %></span></div>
                                            <span class="adm-pill adm-pill--warn adm-num"><%= _fa(p.countInStock) %> عدد</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </section>
                </div>
            </div>

            <div class="adm-grid-2">
                <section class="adm-card" aria-labelledby="dash-products">
                    <div class="adm-card__head"><h3 id="dash-products">آخرین محصولات</h3><button class="adm-link" type="button" onclick="showSection('products')">همه محصولات</button></div>
                    <div class="adm-card__body">
                        <% if (!_d.products.recent.length) { %>
                            <p class="adm-empty">هنوز محصولی اضافه نشده است.</p>
                        <% } else { %>
                            <div class="adm-list">
                                <% _d.products.recent.forEach(function (p) { %>
                                    <div class="adm-list__row">
                                        <img class="adm-list__thumb" src="<%= (p.images && p.images[0] && p.images[0].url) || '/logo.webp' %>" alt="" loading="lazy" width="42" height="42">
                                        <div class="adm-list__main"><strong><%= p.name %></strong><span><%= p.brandName || '' %> · <%= _date(p.createdAt) %></span></div>
                                        <div class="adm-list__end">
                                            <strong class="adm-num"><%= _fa(p.offerPrice || p.price) %></strong>
                                            <span class="adm-pill <%= p.isPublished ? 'adm-pill--ok' : '' %>"><%= p.isPublished ? 'منتشر شده' : 'پیش‌نویس' %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </section>
                <section class="adm-card" aria-labelledby="dash-banners">
