        var ADMIN_SECTIONS = ['dashboard', 'products', 'categories', 'orders', 'weblogs', 'category-manager', 'banners'];
        function showSection(section) {
            if (!ADMIN_SECTIONS.includes(section)) section = 'dashboard';
            closeMobileSidebar();
            ADMIN_SECTIONS.forEach(function (s) {
                const el = document.getElementById(s + 'Content');
                if (el) el.classList.toggle('hidden', s !== section);
            });
            document.querySelectorAll('.sidebar-item').forEach(function (item) {
                const on = item.getAttribute('data-section') === section;
                item.classList.toggle('active', on);
                if (on) item.setAttribute('aria-current', 'page'); else item.removeAttribute('aria-current');
            });
            window.scrollTo({ top: 0 });

            if (section === 'products') {
                loadProducts();
            } else if (section === 'categories') {
                loadCategories();
                loadBrands();
                loadDiscounts();
            } else if (section === 'orders') {
                loadOrdersFromServer();
