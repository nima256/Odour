function prepareOrdersChartData(ordersData) {
    const months = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 
                    'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
    
    if (!ordersData || ordersData.length === 0) {
        // داده نمونه برای ماه جاری
        const now = new Date();
        const currentMonthIndex = now.getMonth();
        return {
            labels: [months[currentMonthIndex]],
            values: [0]
        };
    }
    
    // ساخت مپ از داده‌ها
    const orderMap = new Map();
    ordersData.forEach(item => {
        if (item.month) {
            const match = item.month.match(/-(\d+)/);
            if (match) {
                const monthNum = parseInt(match[1]);
                orderMap.set(monthNum, item.orderCount || 0);
            }
        }
    });
    
    // گرفتن ماه جاری (بر اساس تاریخ واقعی، نه سفارشات)
    const now = new Date();
    const currentMonth = now.getMonth() + 1; // 1-based
    
    const labels = [];
    const values = [];
    
    // گرفتن 6 ماه اخیر
    for (let i = 5; i >= 0; i--) {
        let monthNum = currentMonth - i;
        if (monthNum <= 0) {
            monthNum += 12;
        }
        const monthIndex = monthNum - 1;
        labels.push(months[monthIndex]);
        values.push(orderMap.get(monthNum) || 0);
    }
    
    return { labels, values };
}


