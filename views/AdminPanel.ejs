                    <h2>بنرها</h2>
                    <p>بنرهای صفحه اصلی، فروشگاه و دسته‌بندی‌ها؛ ترتیب، زمان‌بندی و فعال بودن هر بنر را از اینجا مدیریت کنید.</p>
                </div>
                <button class="adm-btn" type="button" data-banner-new><%- icon('plus', 'od-icon--sm') %>بنر جدید</button>
            </div>
            <div data-banner-list></div>

            <dialog class="adm-dialog" data-banner-dialog aria-labelledby="banner-dialog-title">
                <form method="dialog" data-banner-form novalidate>
                    <div class="adm-dialog__head">
                        <h3 id="banner-dialog-title" data-banner-title>بنر جدید</h3>
                        <button class="adm-iconbtn" type="button" data-banner-close aria-label="بستن"><%- icon('x') %></button>
                    </div>
                    <div class="adm-dialog__body">
                        <div class="adm-fields adm-fields--2">
                            <label class="adm-field"><span>جایگاه نمایش</span>
                                <select class="adm-input" name="placement" required>
                                    <% Object.entries(bannerPlacements).forEach(function (pl) { %><option value="<%= pl[0] %>"><%= pl[1] %></option><% }) %>
                                </select>
                            </label>
                            <label class="adm-field"><span>رنگ پنل متن</span>
                                <select class="adm-input" name="theme">
                                    <option value="cream">کرم</option><option value="olive">زیتونی</option><option value="dark">زیتونی تیره</option><option value="light">روشن</option>
                                </select>
                            </label>
                        </div>
                        <div class="adm-fields adm-fields--2">
                            <label class="adm-field"><span>عنوان *</span><input class="adm-input" name="title" maxlength="120" required></label>
                            <label class="adm-field"><span>رو‌تیتر (کوچک، بالای عنوان)</span><input class="adm-input" name="eyebrow" maxlength="60"></label>
                        </div>
                        <label class="adm-field"><span>زیرعنوان</span><textarea class="adm-input" name="subtitle" maxlength="300" rows="2"></textarea></label>
                        <div class="adm-fields adm-fields--2">
                            <label class="adm-field"><span>متن دکمه</span><input class="adm-input" name="ctaText" maxlength="40" placeholder="مشاهده کالکشن"></label>
                            <label class="adm-field"><span>لینک مقصد</span><input class="adm-input" name="url" dir="ltr" placeholder="/shop?discount=1"><small>با / شروع شود یا آدرس کامل https باشد</small></label>
                        </div>
                        <label class="adm-field" data-banner-catfield><span>فقط در دسته‌بندی</span>
                            <select class="adm-input" name="categorySlug">
                                <option value="">همه صفحات فروشگاه و دسته‌بندی</option>
                                <% categories.forEach(function (c) { %><option value="<%= c.slug %>"><%= c.name %></option><% }) %>
                            </select>
                        </label>

                        <p class="adm-section-title">تصاویر</p>
                        <div class="adm-fields adm-fields--2">
                            <div class="adm-upload" data-banner-upload="image">
                                <span class="adm-field"><span>تصویر دسکتاپ</span></span>
                                <div class="adm-upload__preview" data-preview>بدون تصویر</div>
                                <div class="adm-upload__row">
                                    <label class="adm-btn adm-btn--ghost adm-btn--sm">انتخاب<input type="file" accept="image/jpeg,image/png,image/webp,image/avif" hidden data-file></label>
                                    <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" data-clear hidden>حذف</button>
                                </div>
                                <small class="adm-note">پیشنهاد: ۱۹۲۰×۸۰۰ پیکسل</small>
                            </div>
                            <div class="adm-upload" data-banner-upload="mobileImage">
                                <span class="adm-field"><span>تصویر موبایل (اختیاری)</span></span>
                                <div class="adm-upload__preview" data-preview>همان تصویر دسکتاپ</div>
                                <div class="adm-upload__row">
                                    <label class="adm-btn adm-btn--ghost adm-btn--sm">انتخاب<input type="file" accept="image/jpeg,image/png,image/webp,image/avif" hidden data-file></label>
                                    <button class="adm-btn adm-btn--danger adm-btn--sm" type="button" data-clear hidden>حذف</button>
                                </div>
                                <small class="adm-note">پیشنهاد: ۹۰۰×۱۱۰۰ پیکسل</small>
                            </div>
                        </div>
                        <label class="adm-field"><span>متن جایگزین تصویر</span><input class="adm-input" name="imageAlt" maxlength="140"></label>

                        <p class="adm-section-title">نمایش و زمان‌بندی</p>
                        <div class="adm-fields adm-fields--3">
                            <label class="adm-field"><span>شروع نمایش</span><input class="adm-input" type="datetime-local" name="startsAt"></label>
                            <label class="adm-field"><span>پایان نمایش</span><input class="adm-input" type="datetime-local" name="endsAt"></label>
                            <label class="adm-field"><span>ترتیب</span><input class="adm-input" type="number" name="order" step="1"></label>
                        </div>
                        <label class="adm-switch"><input type="checkbox" name="isActive" checked> فعال</label>
                        <p class="adm-note" data-banner-error role="alert" style="color:var(--a-danger)"></p>
                    </div>
                    <div class="adm-dialog__foot">
                        <button class="adm-btn adm-btn--ghost" type="button" data-banner-close>انصراف</button>
                        <button class="adm-btn" type="submit" data-banner-save>ذخیره بنر</button>
                    </div>
                </form>
            </dialog>
            <script id="adm-banners-data" type="application/json"><%- JSON.stringify({ banners: banners, placements: bannerPlacements }).replace(/</g, '\\u003c') %></script>
            <script src="/js/admin-banners.js?v=<%= assetVersion %>" defer></script>
