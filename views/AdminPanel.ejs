async function snappApiAction(url, body, successMessage, orderId) {
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body || {})
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'عملیات ناموفق بود');
        showNotification(data.message || successMessage, 'success');
        await loadOrdersFromServer();
        if (orderId) viewOrder(orderId);
    } catch (error) {
        showNotification(error.message, 'error');
    }
}

async function snappSyncOrder(orderId) {
    await snappApiAction(`/admin/orders/${orderId}/snappay/sync`, {}, 'وضعیت همگام شد', orderId);
}

async function snappUpdateOrder(orderId) {
    const inputs = [...document.querySelectorAll('[data-snapp-quantity]')];
    const items = inputs.map(input => ({
        itemId: input.dataset.itemId,
        productId: input.dataset.productId,
        quantity: Number(input.value)
    }));
    const order = orders.find(item => item._id === orderId);
    const hasReduction = order?.products?.some(product => {
        const changed = items.find(item => String(item.itemId) === String(product.snappItemId || product.product?._id || product.product));
        return changed && changed.quantity < Number(product.quantity);
    });
    if (!hasReduction) {
        showNotification('حداقل تعداد یک محصول را کاهش دهید', 'error');
        return;
    }
    if (!confirm('این آپدیت در اسنپ‌پی برگشت‌ناپذیر است. از کاهش/حذف آیتم‌ها مطمئن هستید؟')) return;
    await snappApiAction(
        `/admin/orders/${orderId}/snappay/update`,
        { confirmed: true, items },
        'سفارش آپدیت شد',
        orderId
    );
}

async function snappCancelOrder(orderId) {
    if (!confirm('هشدار: کل سفارش در اسنپ‌پی کنسل می‌شود و این عملیات برگشت‌ناپذیر است. ادامه می‌دهید؟')) return;
    await snappApiAction(
        `/admin/orders/${orderId}/snappay/cancel`,
        { confirmed: true },
        'سفارش کنسل شد',
        orderId
    );
}


async function torobSyncOrder(orderId) {
    await snappApiAction(`/admin/orders/${orderId}/torobpay/sync`, {}, 'وضعیت ترب‌پی همگام شد', orderId);
}

async function torobUpdateOrder(orderId) {
    const inputs = [...document.querySelectorAll('[data-torob-quantity]')];
    const items = inputs.map(input => ({
        itemId: input.dataset.itemId,
        productId: input.dataset.productId,
        quantity: Number(input.value)
    }));
    const order = orders.find(item => item._id === orderId);
    const hasReduction = order?.products?.some(product => {
        const productId = product.product?._id || product.product;
        const changed = items.find(item => String(item.productId) === String(productId));
        return changed && changed.quantity < Number(product.quantity);
    });
    if (!hasReduction) {
        showNotification('حداقل تعداد یک محصول را کاهش دهید', 'error');
        return;
    }
    if (!confirm('مبلغ سفارش در ترب‌پی کاهش می‌یابد و مازاد توسط ترب‌پی محاسبه/عودت می‌شود. ادامه می‌دهید؟')) return;
