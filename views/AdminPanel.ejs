        function addFragranceSpecTemplate() {
            const template = [
                ['آکوردهای اصلی', 'مثال: چوبی:100، ادویه‌ای گرم:80، عنبری:65'],
                ['نت آغازین', 'مثال: برگاموت، فلفل صورتی'],
                ['نت میانی', 'مثال: یاس، گل رز'],
                ['نت پایه', 'مثال: وانیل، مشک، صندل'],
                ['گروه بویایی', 'مثال: چوبی ادویه‌ای'],
                ['ماندگاری', 'مثال: ۸ ساعت'],
                ['پخش بو', 'مثال: متوسط'],
                ['زمان مصرف', 'روز / شب / روز و شب'],
                ['فصل', 'مثال: پاییز، زمستان'],
                ['جنسیت', 'مردانه / زنانه / یونیسکس'],
                ['غلظت', 'مثال: ادو پرفیوم'],
                ['حجم', 'مثال: ۱۰۰ میلی‌لیتر'],
            ];
            const existing = Array.from(document.querySelectorAll('#specFields input[name$="[key]"]')).map(i => i.value.trim());
            template.forEach(([key, hint]) => {
                if (existing.includes(key)) return;
                addSpecField(key, '');
                const rows = document.querySelectorAll('#specFields > div');
                const valueInput = rows[rows.length - 1]?.querySelector('input[name$="[value]"]');
                if (valueInput) valueInput.placeholder = hint;
            });
        }

