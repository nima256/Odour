      font-display: swap;
    }
    body { 
      font-family: "MyFont", sans-serif;
    }
    /* در استایل‌های موجود اضافه کنید */
@media (min-width: 768px) {
  .hamburger {
    display: none !important;
  }
  
  .desktop-menu {
    display: flex !important;
  }
}

@media (max-width: 767px) {
  .desktop-menu {
    display: none !important;
  }
  
  .hamburger {
    display: block !important;
  }
}
.cart-count {
    top: -8px;
    left: -8px;
}
@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes slideUp {
    from {
        transform: translateY(20px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes slideDown {
    from {
        transform: translateY(0);
        opacity: 1;
    }
    to {
        transform: translateY(20px);
        opacity: 0;
    }
}

@keyframes fadeOut {
    from {
        opacity: 1;
    }
    to {
        opacity: 0;
    }
}

.modal-backdrop-enter {
    animation: fadeIn 0.25s ease-out forwards;
}

.modal-backdrop-exit {
    animation: fadeOut 0.2s ease-out forwards;
}

.modal-content-enter {
    animation: slideUp 0.25s ease-out forwards;
}

.modal-content-exit {
    animation: slideDown 0.2s ease-out forwards;
}

/* جلوگیری از اسکرول */
body.modal-open {
    overflow: hidden;
}


  @media (min-width: 768px) {
    .desktop-menu {
      display: flex !important;
    }
    .hamburger {
      display: none !important;
    }
  }
  
  /* استایل‌های هاور برای دسکتاپ */
  .dropdown:hover .dropdown-menu {
    display: block !important;
  }
  
  .submenu-item {
    position: relative;
  }
  
  .submenu-item:hover .submenu-level2 {
    display: block !important;
  }
  
  .dropdown-menu a:hover,
  .submenu-level2 a:hover {
    background-color: #f5f5f5;
  }
  
  /* اطمینان از display صحیح */
  .dropdown-menu {
    display: none;
  }
  
  .submenu-level2 {
    display: none;
  }
  
  /* تنظیمات بیشتر برای هاور */
  .dropdown:hover .dropdown-menu {
    display: block;
  }
  
  .submenu-item:hover > .submenu-level2 {
    display: block;
  }
  
  /* استایل برای موبایل */
  @media (max-width: 768px) {
    .flex.items-center.space-x-4 {
      gap: 12px;
    }
  }
  
  .mobile-dropdown-menu,
  .mobile-submenu-level2 {
    transition: all 0.3s ease;
  }
  
  /* استایل cart-count */
  .cart-count {
    top: -8px;
    left: -8px;
  }


