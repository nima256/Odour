    <script>
      function toPersianDigits(num) {
        if (num === null || num === undefined || isNaN(num)) return "";
        const persianDigits = "۰۱۲۳۴۵۶۷۸۹";
        const withCommas = num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return withCommas.replace(/\d/g, (digit) => persianDigits[digit]);
      }

      // Tab functionality
      document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tabName = btn.dataset.tab;

          // Update active tab
          document.querySelectorAll(".tab-btn").forEach((b) => {
            b.classList.remove("tab-active");
            b.classList.add("text-gray-600");
          });
          btn.classList.add("tab-active");
          btn.classList.remove("text-gray-600");

          // Show tab content
          document.querySelectorAll(".tab-content").forEach((content) => {
            content.classList.add("hidden");
          });
          document.getElementById(tabName + "-tab").classList.remove("hidden");
        });
      });

      // Order modal functionality
        function showOrderDetails(element) {
    const orderData = JSON.parse(element.getAttribute('data-order'));
    const productsContainer = document.getElementById("modal-products-container");
    
    // جلوگیری از اسکرول بدنه
    document.body.style.overflow = 'hidden';
    
    productsContainer.innerHTML = '';
    
    orderData.products.forEach(product => {
        productsContainer.innerHTML += `
            <div class="bg-green-50 rounded-xl p-3 border border-green-100">
                <div class="flex gap-3">
                    <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0">
                        <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1">
                        <h5 class="font-medium text-gray-800 text-sm">${product.name}</h5>
                        <div class="flex flex-wrap gap-2 mt-1 text-xs text-gray-500">
                            <span>تعداد: ${toPersianDigits(product.quantity)}</span>
                            <span>رنگ: ${product.selectedColor || '-'}</span>
                            <span>سایز: ${product.selectedSize || '-'}</span>
                        </div>
                    </div>
                    <div class="text-left">
                        ${product.offerPrice ? `
                            <p class="text-gray-400 line-through text-xs">${toPersianDigits(product.price)}</p>
                            <p class="font-bold text-pink-600">${toPersianDigits(product.offerPrice)} تومان</p>
                        ` : `
                            <p class="font-bold text-gray-800">${toPersianDigits(product.price)} تومان</p>
                        `}
                    </div>
                </div>
            </div>
        `;
    });
    
    // آپدیت اطلاعات
    document.getElementById("modal-order-id").textContent = `#${orderData.id}`;
    document.getElementById("modal-order-date").textContent = orderData.date;
    document.getElementById("modal-order-price").textContent = `${toPersianDigits(orderData.totalPrice)} تومان`;
    document.getElementById("addressForInfo").textContent = orderData.address;
    document.getElementById("deliveryForInfo").textContent = orderData.delivery;
    
    // آپدیت وضعیت با رنگ مناسب
    const statusElement = document.getElementById("modal-order-status");
    const status = orderData.status;
    let statusColor = '';
    switch(status) {
        case 'تحویل داده شد': statusColor = 'bg-green-100 text-green-800'; break;
        case 'در حال ارسال': statusColor = 'bg-blue-100 text-blue-800'; break;
        case 'بسته بندی شده': statusColor = 'bg-purple-100 text-purple-800'; break;
        case 'در حال پردازش': statusColor = 'bg-yellow-100 text-yellow-800'; break;
        case 'در انتظار پرداخت': statusColor = 'bg-orange-100 text-orange-800'; break;
        case 'لغو شده': statusColor = 'bg-red-100 text-red-800'; break;
        default: statusColor = 'bg-gray-100 text-gray-800';
    }
    statusElement.className = `inline-flex items-center px-3 py-1 rounded-full text-xs font-medium ${statusColor}`;
    statusElement.textContent = status;
    
    // خلاصه پرداخت
    const discountElement = document.getElementById("modal-discount-price");
    if (orderData.discountAmount > 0) {
        discountElement.textContent = `${toPersianDigits(orderData.discountAmount)} تومان`;
        if (orderData.discount?.originalValue) {
            discountElement.textContent += ` (${orderData.discount.originalValue})`;
        }
    } else {
        discountElement.textContent = "بدون تخفیف";
    }
    
    document.getElementById("modal-total-price").textContent = `${toPersianDigits(orderData.originalPrice)} تومان`;
    document.getElementById("modal-final-price").textContent = `${toPersianDigits(orderData.totalPrice)} تومان`;
    
    // نمایش مودال
    const modal = document.getElementById('order-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => {
        document.getElementById('order-modal-content').classList.add('scale-100');
    }, 10);
}

function closeOrderModal() {
    const modal = document.getElementById('order-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    // آزاد کردن اسکرول بدنه
    document.body.style.overflow = '';
    document.body.classList.remove('modal-open');
}

const orderModal = document.getElementById('order-modal');
if (orderModal) {
    // حذف event listener های قبلی
    const newOrderModal = orderModal.cloneNode(true);
    orderModal.parentNode.replaceChild(newOrderModal, orderModal);
    
    // اضافه کردن event listener جدید
    newOrderModal.addEventListener('click', (e) => {
        if (e.target === newOrderModal) {
            closeOrderModal();
        }
    });
}

// بستن با دکمه ESC
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        const modal = document.getElementById('order-modal');
        if (modal && !modal.classList.contains('hidden')) {
            closeOrderModal();
        }
    }
});

      async function logout() {
        if (confirm('آیا از خروج از حساب کاربری خود مطمئن هستید؟')) {
            try {
                const response = await fetch('/api/authentication/logout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showNotification('با موفقیت خارج شدید', 'success');
                    // ریدایرکت به صفحه اصلی بعد از 1 ثانیه
                    setTimeout(() => {
                        window.location.href = '/';
                    }, 1000);
                } else {
                    showNotification(data.message || 'خطا در خروج از حساب', 'error');
                }
            } catch (error) {
                console.error('Logout error:', error);
                showNotification('خطا در ارتباط با سرور', 'error');
            }
        }
    }

    // توابع کنترل مودال خروج
function showLogoutModal() {
    const modal = document.getElementById('logout-modal');
    const modalContent = document.getElementById('logout-modal-content');
    
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('modal-open');
        
        // اضافه کردن انیمیشن
        if (modalContent) {
            modalContent.classList.remove('modal-content-exit');
            modalContent.classList.add('modal-content-enter');
        }
    }
}

function closeLogoutModal() {
    const modal = document.getElementById('logout-modal');
    const modalContent = document.getElementById('logout-modal-content');
    
    if (modalContent) {
        modalContent.classList.remove('modal-content-enter');
        modalContent.classList.add('modal-content-exit');
        
        setTimeout(() => {
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('modal-open');
            }
        }, 200);
    } else if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('modal-open');
    }
}

// بستن با کلیک روی پس‌زمینه
document.addEventListener('click', function(event) {
    const modal = document.getElementById('logout-modal');
    if (event.target === modal) {
        closeLogoutModal();
    }
});

// بستن با دکمه Escape
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        const modal = document.getElementById('logout-modal');
        if (modal && !modal.classList.contains('hidden')) {
            closeLogoutModal();
        }
    }
});

// تابع خروج واقعی
async function confirmLogout() {
    try {
        const response = await fetch('/api/authentication/logout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            closeLogoutModal();
            showNotification('با موفقیت خارج شدید', 'success');
            setTimeout(() => {
                window.location.href = '/';
            }, 1000);
        } else {
            showNotification(data.message || 'خطا در خروج از حساب', 'error');
            closeLogoutModal();
        }
    } catch (error) {
        console.error('Logout error:', error);
        showNotification('خطا در ارتباط با سرور', 'error');
        closeLogoutModal();
    }
}
    </script>
    
  </body>
