    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "name": "پروفایل کاربری",
      "description": "مدیریت حساب کاربری، مشاهده سفارشات، اطلاعات شخصی و تاریخچه خرید در فروشگاه اودر",
      "url": "https://odour.ir/userProfile",
      "inLanguage": "fa-IR",
      "dateModified": "2026-01-15T10:00:00+03:30",
      "isPartOf": {
        "@type": "WebSite",
        "name": "اودر",
        "url": "https://odour.ir"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "خانه",
            "item": "https://odour.ir"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "حساب کاربری",
            "item": "https://odour.ir/userProfile"
          }
        ]
      },
      "mainEntity": {
        "@type": "Person",
        "name": "<%= user.fullName %>",
        "email": "<%= user.email %>",
        "telephone": "<%= user.mobile %>",
        "memberSince": "<%= user.createdAt ? user.createdAt.toISOString().split('T')[0] : '2024-01-01' %>",
        "mainEntityOfPage": {
          "@type": "ProfilePage",
          "@id": "https://odour.ir/userProfile"
        }
      }
    }
    </script>


