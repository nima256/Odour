                <input type="text" maxlength="1" class="otp-input w-12 h-14 text-center text-xl border rounded-lg" dir="ltr" required />
                <input type="text" maxlength="1" class="otp-input w-12 h-14 text-center text-xl border rounded-lg" dir="ltr" required />
                <input type="text" maxlength="1" class="otp-input w-12 h-14 text-center text-xl border rounded-lg" dir="ltr" required />
