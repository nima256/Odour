    <script>
    // ==================== بخش نظرات محصول ====================
const productIdForComments = '<%= product?._id %>';

let allComments = [];
let currentPage = 1;
const commentsPerPage = 5;

// تبدیل اعداد به فارسی
function toPersianDigitsForComments(num) {
  if (num === undefined || num === null) return '۰';
  return num.toString().replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
}

// تابع escape برای جلوگیری از XSS
function escapeHtmlForComments(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// بارگذاری نظرات از سرور
async function loadComments(page = 1) {
  try {
    const response = await fetch(`/api/comments/product/${productIdForComments}?page=${page}&limit=${commentsPerPage}`);
    const data = await response.json();
    
    if (data.success) {
      if (page === 1) {
        allComments = data.comments;
      } else {
        allComments = [...allComments, ...data.comments];
      }
      
      currentPage = page;
      
      // به‌روزرسانی نمایش امتیاز و تعداد نظرات
      const commentsCountDisplay = document.getElementById('comments-count-display');
      const averageRatingDisplay = document.getElementById('average-rating-display');
      
      if (commentsCountDisplay) {
        commentsCountDisplay.textContent = toPersianDigitsForComments(data.totalComments);
      }
      
      if (averageRatingDisplay) {
        averageRatingDisplay.textContent = data.averageRating ? data.averageRating.toFixed(1) : '۰';
      }
      
      // نمایش نظرات
      renderComments(allComments);
      
      // مدیریت دکمه بارگذاری بیشتر
      const loadMoreContainer = document.getElementById('load-more-container');
      if (data.hasMore) {
        loadMoreContainer.classList.remove('hidden');
      } else {
        loadMoreContainer.classList.add('hidden');
      }
    }
  } catch (error) {
    console.error('خطا در بارگذاری نظرات:', error);
  }
}

// رندر کردن نظرات
function renderComments(comments) {
  const commentsList = document.getElementById('comments-list');
  const noCommentsMessage = document.getElementById('no-comments-message');
  
  if (!commentsList) return;
  
  if (comments.length === 0) {
    if (noCommentsMessage) noCommentsMessage.style.display = 'block';
    commentsList.innerHTML = '';
    if (noCommentsMessage) commentsList.appendChild(noCommentsMessage);
    return;
  }
  
  if (noCommentsMessage) noCommentsMessage.style.display = 'none';
  
  let commentsHtml = '';
  
  comments.forEach(comment => {
    // ساخت ستاره‌های امتیاز
    let starsHtml = '';
    const rating = comment.rating || 0;
    for (let i = 1; i <= 5; i++) {
      if (i <= rating) {
        starsHtml += '<i class="fas fa-star text-yellow-400 text-sm"></i>';
      } else {
        starsHtml += '<i class="far fa-star text-gray-300 text-sm"></i>';
      }
    }
    
    // تاریخ
    const commentDate = new Date(comment.createdAt);
    const persianDate = `${toPersianDigitsForComments(commentDate.getFullYear())}/${toPersianDigitsForComments(commentDate.getMonth() + 1)}/${toPersianDigitsForComments(commentDate.getDate())}`;
    
    commentsHtml += `
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="flex justify-between items-start mb-2">
          <div class="flex items-center gap-2">
            <div style="background-color: #8a8a5a;" class="w-8 h-8  rounded-full flex items-center justify-center text-white text-sm font-bold">
              ${comment.userName ? comment.userName.charAt(0).toUpperCase() : 'ک'}
            </div>
            <div>
              <span class="font-semibold text-gray-800">${escapeHtmlForComments(comment.userName || 'کاربر مهمان')}</span>
              <div class="flex items-center gap-1 mt-0.5">
                ${starsHtml}
              </div>
            </div>
          </div>
          <span class="text-xs text-gray-400">${persianDate}</span>
        </div>
        <p class="text-gray-600 text-sm leading-relaxed pr-10 mr-1">${escapeHtmlForComments(comment.text)}</p>
      </div>
    `;
  });
  
  commentsList.innerHTML = commentsHtml;
}

// ثبت نظر جدید
async function submitComment(event) {
  event.preventDefault();
  
  const ratingInput = document.querySelector('input[name="rating"]:checked');
  const rating = ratingInput ? parseInt(ratingInput.value) : 0;
  const userName = document.getElementById('comment-name')?.value.trim();
  const commentText = document.getElementById('comment-text')?.value.trim();
  
  // اعتبارسنجی
  if (rating === 0) {
    showNotificationForComments('لطفاً به محصول امتیاز دهید', 'error');
    return;
  }
  
  if (!userName) {
    showNotificationForComments('لطفاً نام خود را وارد کنید', 'error');
    return;
  }
  
  if (!commentText) {
    showNotificationForComments('لطفاً متن نظر را وارد کنید', 'error');
    return;
  }
  
  if (commentText.length < 5) {
    showNotificationForComments('متن نظر باید حداقل ۵ کاراکتر باشد', 'error');
    return;
  }
  
  try {
    const response = await fetch('/api/comments/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        productId: productIdForComments,
        userName: userName,
        rating: rating,
        text: commentText
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showNotificationForComments('نظر شما با موفقیت ثبت شد', 'success');
      
      document.getElementById('comment-form').reset();
      document.querySelectorAll('.rating-stars label').forEach(label => {
        label.classList.remove('text-yellow-400');
        label.classList.add('text-gray-300');
      });
      
      await loadComments(1);
    } else {
      showNotificationForComments(data.message || 'خطا در ثبت نظر', 'error');
    }
  } catch (error) {
    console.error('خطا در ثبت نظر:', error);
    showNotificationForComments('مشکلی در ارتباط با سرور به وجود آمده است', 'error');
  }
}

// نوتیفیکیشن
function showNotificationForComments(message, type = 'info') {
  const notification = document.createElement('div');
  notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
    type === 'success' ? 'bg-green-500' :
    type === 'error' ? 'bg-red-500' :
    'bg-blue-500'
  } top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:top-6 sm:right-6 w-[calc(100%-2rem)] max-w-xs sm:max-w-sm`;
  
  notification.textContent = message;
  document.body.appendChild(notification);
  
  notification.classList.add('transform', 'transition-all', 'duration-300', 'translate-y-2', 'opacity-0');
  setTimeout(() => {
    notification.classList.remove('translate-y-2', 'opacity-0');
  }, 10);
  
  setTimeout(() => {
    notification.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => notification.remove(), 300);
  }, 800);
}

// راه‌اندازی ستاره‌های ریتینگ
function setupRatingStars() {
  const starsContainer = document.querySelector('.rating-stars');
  if (!starsContainer) return;
  
  const stars = starsContainer.querySelectorAll('label');
  
  stars.forEach((star, index) => {
    star.addEventListener('click', () => {
      stars.forEach(s => {
        s.classList.remove('text-yellow-400');
        s.classList.add('text-gray-300');
      });
      for (let i = stars.length - 1; i >= index; i--) {
        stars[i].classList.remove('text-gray-300');
        stars[i].classList.add('text-yellow-400');
      }
    });
  });
}

// مقداردهی اولیه
function initCommentsSection() {
  if (!productIdForComments || productIdForComments === 'undefined') {
    console.warn('productId برای بخش نظرات موجود نیست');
    return;
  }
  
  setupRatingStars();
  loadComments(1);
  
  const commentForm = document.getElementById('comment-form');
  if (commentForm) {
    commentForm.addEventListener('submit', submitComment);
  }
  
  const loadMoreBtn = document.getElementById('load-more-comments');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      loadComments(currentPage + 1);
    });
  }
}

// اجرا بعد از بارگذاری صفحه
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCommentsSection);
} else {
  initCommentsSection();
}
      document.addEventListener('DOMContentLoaded', function() {
          // Image gallery functionality
          const thumbnails = document.querySelectorAll('.thumbnail');
          const mainImage = document.getElementById('main-image');

          const productImages = <%- JSON.stringify(product.images.map(img => img.url)) %>;

          thumbnails.forEach((thumb, index) => {
              thumb.addEventListener('click', () => {
                  thumbnails.forEach(t => t.classList.remove('active'));
                  thumb.classList.add('active');
                  mainImage.src = productImages[index];
                  mainImage.dataset.galleryIndex = String(index);
              });
          });

          // Color selector + Torob variant query functionality
          const colorSwatches = Array.from(document.querySelectorAll('.color-swatch'));
          const selectedColorSpan = document.getElementById('selected-color');
          const colorSpecMeta = document.getElementById('torob-color-spec');
          const genderSpecMeta = document.getElementById('torob-gender-spec');
          const variantMeta = document.getElementById('torob-variant-id');
          const productIdMeta = document.getElementById('torob-product-id');
          const sizeSpecMeta = document.getElementById('torob-size-spec');
          const productNameMeta = document.getElementById('product-name-meta');
          const ogTitleMeta = document.getElementById('og-title-meta');
          const ogImageMeta = document.getElementById('og-image-meta');
          const ogUrlMeta = document.getElementById('og-url-meta');
          const canonicalLink = document.getElementById('torob-canonical');
          const pageTitleHeading = document.getElementById('product-page-title');
          const productJsonLd = document.getElementById('torob-product-jsonld');
          const torobProductBaseName = <%- JSON.stringify(product?.name || '') %>;
          const torobProductEnglishName = <%- JSON.stringify(product?.englishName || '') %>;
          const torobProductGender = <%- JSON.stringify(torobGender || '') %>;
          const torobProductId = <%- JSON.stringify(String(product?._id || '')) %>;

          const normalizeImageUrl = (value) => {
              if (!value) return '';
              try {
                  return new URL(value, window.location.origin).href;
              } catch (_) {
                  return String(value);
              }
          };

          const updateVariantQuery = (variantId) => {
              const url = new URL(window.location.href);
              if (variantId) {
                  url.searchParams.set('variant', variantId);
              } else {
                  url.searchParams.delete('variant');
              }
              // پارامترهای ورودی ترب مانند utm_source و torob_clid دست‌نخورده می‌مانند.
              window.history.replaceState({ variantId, sizeId: url.searchParams.get('size') || '' }, '', url.toString());
          };

          const updateSizeQuery = (sizeId) => {
              const url = new URL(window.location.href);
              if (sizeId) {
                  url.searchParams.set('size', sizeId);
              } else {
                  url.searchParams.delete('size');
              }
              window.history.replaceState({ variantId: url.searchParams.get('variant') || '', sizeId }, '', url.toString());
          };

          const getCurrentSizeState = () => {
              const allOptions = Array.from(document.querySelectorAll('.volume-option'));
              const requestedSizeId = new URLSearchParams(window.location.search).get('size') || '';
              const option =
                  allOptions.find(item => item.classList.contains('selected')) ||
                  allOptions.find(item => item.dataset.unavailable !== 'true' && item.dataset.sizeId === requestedSizeId) ||
                  allOptions.find(item => item.dataset.unavailable !== 'true') ||
                  null;
              return {
                  sizeId: option?.dataset.sizeId || requestedSizeId,
                  sizeName: option?.dataset.volume || '',
              };
          };

          const buildClientVariantTitle = (colorName, sizeName) => {
              const parts = [torobProductBaseName];
              if (colorName) parts.push(`رنگ ${colorName}`);
              if (sizeName) parts.push(`سایز ${sizeName}`);
              if (torobProductGender && !parts.some(part => part.includes(torobProductGender))) {
                  parts.push(torobProductGender);
              }
              const visibleTitle = parts.filter(Boolean).join(' - ');
              return {
                  visibleTitle,
                  pageTitle: torobProductEnglishName
                      ? `${visibleTitle} | ${torobProductEnglishName}`
                      : visibleTitle,
              };
          };

          const updateClientSeo = ({ colorName, variantId, imageUrl }) => {
              const { sizeId, sizeName } = getCurrentSizeState();
              const titles = buildClientVariantTitle(colorName, sizeName);
              const variantKey = variantId && sizeId
                  ? `${variantId}--size-${sizeId}`
                  : variantId
                      ? variantId
                      : sizeId
                          ? `size-${sizeId}`
                          : 'base';
              const variantUnique = `${torobProductId}_${variantKey}`;

              document.title = titles.pageTitle;
              if (pageTitleHeading) pageTitleHeading.textContent = titles.visibleTitle;
              if (productNameMeta) productNameMeta.setAttribute('content', titles.pageTitle);
              if (productIdMeta) productIdMeta.setAttribute('content', variantUnique);
              if (variantMeta) variantMeta.setAttribute('content', variantKey);
              if (ogTitleMeta) ogTitleMeta.setAttribute('content', titles.pageTitle);
              if (genderSpecMeta && torobProductGender) {
                  genderSpecMeta.setAttribute('content', `جنسیت: ${torobProductGender}`);
              }
              if (sizeSpecMeta && sizeName) {
                  sizeSpecMeta.setAttribute('content', `سایز: ${sizeName}`);
              }

              const canonicalUrl = new URL(window.location.pathname, window.location.origin);
              if (variantId) canonicalUrl.searchParams.set('variant', variantId);
              if (sizeId) canonicalUrl.searchParams.set('size', sizeId);
              if (canonicalLink) canonicalLink.setAttribute('href', canonicalUrl.toString());
              if (ogUrlMeta) ogUrlMeta.setAttribute('content', canonicalUrl.toString());

              if (productJsonLd) {
                  try {
                      const schema = JSON.parse(productJsonLd.textContent || '{}');
                      schema.name = titles.pageTitle;
                      schema.color = colorName || undefined;
                      schema.size = sizeName || undefined;
                      schema.sku = variantUnique;
                      schema.mpn = variantUnique;
                      if (imageUrl) schema.image = [normalizeImageUrl(imageUrl)];
                      if (schema.offers) schema.offers.url = canonicalUrl.toString();
                      productJsonLd.textContent = JSON.stringify(schema);
                  } catch (error) {
                      console.warn('Unable to update Product JSON-LD:', error);
                  }
              }
          };

          const selectColorSwatch = (swatch, { updateUrl = false } = {}) => {
              if (!swatch || swatch.dataset.unavailable === 'true') return;

              colorSwatches.forEach(item => {
                  item.classList.remove('selected', 'ring-2', 'ring-[#636337]');
              });
              swatch.classList.add('selected', 'ring-2', 'ring-[#636337]');

              const colorName = swatch.dataset.color || '';
              const variantId = swatch.dataset.variantId || '';
              const imageUrl = swatch.dataset.image || '';

              if (selectedColorSpan) selectedColorSpan.textContent = colorName;
              if (colorSpecMeta) colorSpecMeta.setAttribute('content', `رنگ: ${colorName}`);
              if (variantMeta) variantMeta.setAttribute('content', variantId || 'base');
              updateClientSeo({ colorName, variantId, imageUrl });

              if (imageUrl && mainImage) {
                  mainImage.src = imageUrl;
                  if (ogImageMeta) ogImageMeta.setAttribute('content', imageUrl);

                  const normalizedSelectedImage = normalizeImageUrl(imageUrl);
                  let matchIndex = productImages.findIndex(
                      image => normalizeImageUrl(image) === normalizedSelectedImage
                  );

                  // اگر عکس اختصاصی رنگ در آرایه اصلی محصول نبود، آن را فقط برای گالری
                  // سمت کاربر اضافه می‌کنیم تا کلیک روی تصویر اصلی نیز همان عکس را باز کند.
                  if (matchIndex === -1 && typeof galleryImages !== 'undefined') {
                      matchIndex = galleryImages.findIndex(
                          image => normalizeImageUrl(image) === normalizedSelectedImage
                      );
                      if (matchIndex === -1) {
                          galleryImages.push(imageUrl);
                          matchIndex = galleryImages.length - 1;
                      }
                  }

                  thumbnails.forEach(item => item.classList.remove('active'));
                  if (matchIndex > -1 && thumbnails[matchIndex]) {
                      thumbnails[matchIndex].classList.add('active');
                  }
                  mainImage.dataset.galleryIndex = String(Math.max(matchIndex, 0));
              }

              if (updateUrl) updateVariantQuery(variantId);
          };

          if (colorSwatches.length > 0 && selectedColorSpan) {
              colorSwatches.forEach(swatch => {
                  swatch.addEventListener('click', () => {
                      if (swatch.dataset.unavailable === 'true') return;
                      selectColorSwatch(swatch, { updateUrl: true });
                      updateVariantPurchaseState();
                  });
              });

              const query = new URLSearchParams(window.location.search);
              const requestedVariantId = query.get('variant');
              const requestedColorName = query.get('color');
              const initialSwatch =
                  colorSwatches.find(item => item.dataset.unavailable !== 'true' && item.dataset.variantId === requestedVariantId) ||
                  colorSwatches.find(item => item.dataset.unavailable !== 'true' && item.dataset.color === requestedColorName) ||
                  colorSwatches.find(item => item.dataset.unavailable !== 'true');

              if (initialSwatch) {
                  selectColorSwatch(initialSwatch, { updateUrl: false });
              } else if (selectedColorSpan) {
                  selectedColorSpan.textContent = 'ناموجود';
              }
          } else if (selectedColorSpan) {
              selectedColorSpan.parentElement.style.display = 'none';
          }


          // Volume selector functionality
          const volumeOptions = Array.from(document.querySelectorAll('.volume-option'));
          const selectedVolumeSpan = document.getElementById('selected-volume');
          const addToCartButton = document.getElementById('add-to-cart');

          const selectVolumeOption = (option) => {
              if (!option || option.dataset.unavailable === 'true') return;

              volumeOptions.forEach(opt => {
                  opt.classList.remove('selected', 'bg-gradient-to-r', 'from-[#636337]', 'to-[#8a8a5a]', 'text-white', 'border-transparent');
                  if (opt.dataset.unavailable !== 'true') {
                      opt.classList.add('bg-gray-50', 'hover:bg-gray-100');
                  }
                  const usage = opt.querySelector('.volume-usage');
                  if (usage) {
                      usage.classList.remove('text-white', 'text-white/90');
                      usage.classList.add('text-gray-500');
                  }
              });

              option.classList.add('selected', 'bg-gradient-to-r', 'from-[#636337]', 'to-[#8a8a5a]', 'text-white', 'border-transparent');
              option.classList.remove('bg-gray-50', 'hover:bg-gray-100');

              const selectedUsage = option.querySelector('.volume-usage');
              if (selectedUsage) {
                  selectedUsage.classList.add('text-white');
                  selectedUsage.classList.remove('text-gray-500');
              }

              if (selectedVolumeSpan) selectedVolumeSpan.textContent = option.dataset.volume;
          };

          const availableVolumeOptions = volumeOptions.filter(option => option.dataset.unavailable !== 'true');
          const requestedSizeId = new URLSearchParams(window.location.search).get('size');
          const initialVolumeOption =
              availableVolumeOptions.find(option => option.dataset.sizeId === requestedSizeId) ||
              availableVolumeOptions[0] ||
              null;

          if (initialVolumeOption) {
              selectVolumeOption(initialVolumeOption);
              const activeColor = document.querySelector('.color-swatch.selected');
              updateClientSeo({
                  colorName: activeColor?.dataset.color || '',
                  variantId: activeColor?.dataset.variantId || '',
                  imageUrl: activeColor?.dataset.image || '',
              });
          } else if (selectedVolumeSpan && volumeOptions.length > 0) {
              selectedVolumeSpan.textContent = 'ناموجود';
          }

          volumeOptions.forEach(option => {
              option.addEventListener('click', () => {
                  if (option.dataset.unavailable === 'true') return;
                  selectVolumeOption(option);
                  updateSizeQuery(option.dataset.sizeId || '');
                  const activeColor = document.querySelector('.color-swatch.selected');
                  updateClientSeo({
                      colorName: activeColor?.dataset.color || '',
                      variantId: activeColor?.dataset.variantId || '',
                      imageUrl: activeColor?.dataset.image || '',
                  });
                  updateVariantPurchaseState();
              });
          });

          function updateVariantPurchaseState() {
              if (!addToCartButton) return;
              const hasColorVariants = colorSwatches.length > 0;
              const hasSizeVariants = volumeOptions.length > 0;
              const selectedColor = document.querySelector('.color-swatch.selected');
              const selectedSize = document.querySelector('.volume-option.selected');
              const selectionUnavailable =
                  (hasColorVariants && (!selectedColor || selectedColor.dataset.unavailable === 'true')) ||
                  (hasSizeVariants && (!selectedSize || selectedSize.dataset.unavailable === 'true'));

              addToCartButton.disabled = selectionUnavailable;
              addToCartButton.classList.toggle('opacity-50', selectionUnavailable);
              addToCartButton.classList.toggle('cursor-not-allowed', selectionUnavailable);
              addToCartButton.textContent = selectionUnavailable ? 'تنوع انتخابی ناموجود است' : 'افزودن به سبد خرید';
          }

          updateVariantPurchaseState();

          // ==================== بخش تب‌ها ====================
          const tabButtons = document.querySelectorAll('.tab-button');
          const tabContents = {
            description: document.getElementById('tab-description'),
            features: document.getElementById('tab-features')
          };
          const tocContainer = document.getElementById('productTOC');
          
           function clearTOC() {
                if (tocContainer) {
                    tocContainer.innerHTML = '';
                    tocContainer.style.display = 'none';
                }
            }
          
          function switchTab(tabId) {
            // غیرفعال کردن همه تب‌ها
            tabButtons.forEach(btn => {
              btn.classList.remove('active', 'text-pink-500');
              btn.classList.add('text-gray-500');
            });
            
            // مخفی کردن همه محتواها
            Object.values(tabContents).forEach(content => {
                if (content) {
                    content.classList.remove('active');
                    // اگر محتوای تب شامل المنت TOC است، آن را پاک کن
                    const tocInside = content.querySelector('#productTOC');
                    if (tocInside) {
                        tocInside.innerHTML = '';
                        tocInside.style.display = 'none';
                    }
                }
            });
            
            // فعال کردن تب انتخاب شده
            const activeButton = document.querySelector(`.tab-button[data-tab="${tabId}"]`);
            if (activeButton) {
              activeButton.classList.add('active', 'text-pink-500');
              activeButton.classList.remove('text-gray-500');
            }
            
            // نمایش محتوای مربوطه
            if (tabContents[tabId]) {
              tabContents[tabId].classList.add('active');
            }
            
            
            if (tabId === 'description') {
                setTimeout(function() {
                    // ابتدا TOC را پاک کن تا مطمئن شویم از شر محتوای قبلی خلاص شده‌ایم
                    if (tocContainer) {
                        tocContainer.innerHTML = '';
                    }
                    // دوباره تولید کن
                    if (typeof generateTableOfContents === 'function') {
                        generateTableOfContents('#productDescriptionContent', '#productTOC');
                    }
                }, 100);
            } else if (tabId === 'features') {
                // اطمینان از پنهان بودن TOC در تب ویژگی‌ها
                setTimeout(function() {
                    if (tocContainer) {
                        tocContainer.innerHTML = '';
                        tocContainer.style.display = 'none';
                    }
                }, 50);
            }
          }
          
          // اضافه کردن event listener به دکمه‌های تب
          tabButtons.forEach(button => {
            button.addEventListener('click', () => {
              const tabId = button.getAttribute('data-tab');
              if (tabId) switchTab(tabId);
            });
          });

          // switchTab('description');
      });

      function toEnglishDigits(str) {
      const persianNumbers = [/۰/g, /۱/g, /۲/g, /۳/g, /۴/g, /۵/g, /۶/g, /۷/g, /۸/g, /۹/g];
      const arabicNumbers = [/٠/g, /١/g, /٢/g, /٣/g, /٤/g, /٥/g, /٦/g, /٧/g, /٨/g, /٩/g];

      if(typeof str === 'string') {
          for(let i=0; i<10; i++) {
          str = str.replace(persianNumbers[i], i).replace(arabicNumbers[i], i);
          }
      }
      return str;
      }

      function addToCart(productName, id) {
            const colorSwatch = document.querySelector('.color-swatch.selected');
            const selectedColor = colorSwatch ? colorSwatch.dataset.color : null;

          const volumeOption = document.querySelector('.volume-option.selected');
          const selectedSize = volumeOption ? toEnglishDigits(volumeOption.dataset.volume) : null;

          if ((colorSwatch && colorSwatch.dataset.unavailable === 'true') ||
              (volumeOption && volumeOption.dataset.unavailable === 'true')) {
              showNotification('تنوع انتخاب‌شده ناموجود است', 'error');
              return;
          }
          
          const requestBody = {
            productId: id,
            quantity: 1,
            };
            
            // فقط اگر رنگ وجود داشت، به body اضافه کن
            if (selectedColor) {
                requestBody.selectedColor = selectedColor.trim();
            }

            const selectedVariantId = colorSwatch ? colorSwatch.dataset.variantId : null;
            if (selectedVariantId) {
                requestBody.selectedVariantId = selectedVariantId;
            }
            
          if (selectedSize) {
            requestBody.selectedSize = selectedSize.trim();
          }
          const selectedSizeId = volumeOption ? volumeOption.dataset.sizeId : null;
          if (selectedSizeId) {
            requestBody.selectedSizeId = selectedSizeId;
          }

          fetch("/api/cart/add", {
              method: "POST",
              headers: {
                  "Content-Type": "application/json",
              },
              body: JSON.stringify(requestBody),
          })
          .then((res) => res.json())
          .then((data) => {
              if (data.success) {
                  showNotification(`محصول مورد نظر به سبد خرید اضافه شد`, 'success');
                  setTimeout(() => {
                      location.reload();
                  }, 800);
              } else {
                  showNotification(data.message, 'error');
              }
          })
          .catch((err) => {
              console.error("Error:", err);
              showNotification('مشکلی در ارتباط با سرور به وجود آمده است', 'error');
          });
      }

      function showNotification(message, type = 'info') {
          const notification = document.createElement('div');
          notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
              type === 'success' ? 'bg-green-500' :
              type === 'error' ? 'bg-red-500' :
              'bg-blue-500'
          }`;

          // Mobile: centered at top, Desktop: top-right
          notification.className += ' top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:top-6 sm:right-6';

          // Width control
          notification.className += ' w-[calc(100%-2rem)] max-w-xs sm:max-w-sm';

          notification.textContent = message;

          document.body.appendChild(notification);

          // Animation in
          notification.classList.add('transform', 'transition-all', 'duration-300');
          notification.classList.add('translate-y-2', 'opacity-0');

          setTimeout(() => {
              notification.classList.remove('translate-y-2', 'opacity-0');
          }, 10);

          setTimeout(() => {
              notification.classList.add('opacity-0', 'translate-y-2');
              setTimeout(() => notification.remove(), 300);
          }, 800);
      }
      
    </script>
    <script>
document.addEventListener('DOMContentLoaded', function() {
  if (document.getElementById('product-gallery')) {
    lightGallery(document.getElementById('product-gallery'), {
      selector: '.gallery-item',
      thumbnail: true,
      download: false,
      counter: true,
      zoom: true,
      speed: 500,
      actualSize: false
    });
  }
    setTimeout(function() {
        if (typeof generateTableOfContents === 'function') {
            generateTableOfContents('#productDescriptionContent', '#productTOC');
        }
    }, 200);
});
// گالری تصاویر
// گالری تصاویر پیشرفته
// گالری تصاویر پیشرفته با فول اسکرین
let currentImageIndex = 0;
let galleryImages = <%- JSON.stringify(product.images.map(img => img.url)) %>;

function openGallery(index) {
  currentImageIndex = index;
  
  // به‌روزرسانی تصویر اصلی
  const mainImage = document.getElementById('main-image');
  if (mainImage) {
    mainImage.src = galleryImages[currentImageIndex];
  }
  
  // آپدیت کردن کلاس active تامبنیل‌ها
  const thumbnails = document.querySelectorAll('.thumbnail');
  thumbnails.forEach((thumb, i) => {
    if (i === currentImageIndex) {
      thumb.classList.add('active');
    } else {
      thumb.classList.remove('active');
    }
  });
  
  // باز کردن پاپ‌آپ گالری
  openGalleryPopup(currentImageIndex);
}

function openGalleryPopup(index) {
  const popup = document.getElementById('gallery-popup');
  if (!popup) return;
  
  currentImageIndex = index;
  
  // ساخت thumbnails داخل پاپ‌آپ
  const thumbnailsContainer = document.getElementById('gallery-thumbnails');
  if (thumbnailsContainer && galleryImages.length > 0) {
    thumbnailsContainer.innerHTML = '';
    galleryImages.forEach((img, i) => {
      const thumbImg = document.createElement('img');
      thumbImg.src = img;
      thumbImg.alt = `تصویر ${i + 1}`;
      thumbImg.onclick = (function(idx) {
        return function() { 
          currentImageIndex = idx;
          updateGalleryImage();
        };
      })(i);
      if (i === currentImageIndex) {
        thumbImg.classList.add('active');
      }
      thumbnailsContainer.appendChild(thumbImg);
    });
  }
  
  // تنظیم تصویر اصلی پاپ‌آپ
  const galleryImage = document.getElementById('gallery-image');
  const galleryCounter = document.getElementById('gallery-counter');
  
  if (galleryImage) {
    galleryImage.src = galleryImages[currentImageIndex];
  }
  if (galleryCounter) {
    galleryCounter.textContent = `${toPersianDigits(currentImageIndex + 1)} از ${toPersianDigits(galleryImages.length)}`;
  }
  
  // نمایش پاپ‌آپ با انیمیشن
  popup.style.display = 'flex';
  popup.classList.add('active');
  document.body.style.overflow = 'hidden';
  
  // اضافه کردن event listener برای کلیدهای کیبورد
  document.addEventListener('keydown', handleGalleryKeydown);
}

function closeGallery() {
  const popup = document.getElementById('gallery-popup');
  if (popup) {
    popup.classList.remove('active');
    popup.style.display = 'none';
  }
  document.body.style.overflow = 'auto';
  document.removeEventListener('keydown', handleGalleryKeydown);
}

function nextImage() {
  if (!galleryImages.length) return;
  currentImageIndex = (currentImageIndex + 1) % galleryImages.length;
  updateGalleryImage();
}

function prevImage() {
  if (!galleryImages.length) return;
  currentImageIndex = (currentImageIndex - 1 + galleryImages.length) % galleryImages.length;
  updateGalleryImage();
}

function updateGalleryImage() {
  const galleryImage = document.getElementById('gallery-image');
  const galleryCounter = document.getElementById('gallery-counter');
  const thumbnails = document.querySelectorAll('#gallery-thumbnails img');
  
  if (galleryImage) {
    galleryImage.src = galleryImages[currentImageIndex];
  }
  if (galleryCounter) {
    galleryCounter.textContent = `${toPersianDigits(currentImageIndex + 1)} از ${toPersianDigits(galleryImages.length)}`;
  }
  
  // آپدیت active thumbnail
  thumbnails.forEach((thumb, i) => {
    if (i === currentImageIndex) {
      thumb.classList.add('active');
    } else {
      thumb.classList.remove('active');
    }
  });
}

function handleGalleryKeydown(e) {
  if (e.key === 'Escape') {
    closeGallery();
  } else if (e.key === 'ArrowRight') {
    nextImage();
  } else if (e.key === 'ArrowLeft') {
    prevImage();
  }
}

// تابع تبدیل اعداد به فارسی
function toPersianDigits(str) {
  if (str === undefined || str === null) return '۰';
  const num = str.toString();
  return num.replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
}

// تابع تولید جدول محتویات خودکار
function generateTableOfContents(contentSelector, tocContainerSelector) {
    const contentElement = document.querySelector(contentSelector);
    const tocContainer = document.querySelector(tocContainerSelector);
    
    if (tocContainer && tocContainer.closest('#tab-features')) {
        tocContainer.style.display = 'none';
        tocContainer.innerHTML = ''; // خالی کردن محتوا
        return;
    }
    
    if (!contentElement || !tocContainer) return;
    
    // پیدا کردن تمام هدینگ‌ها (h1, h2, h3)
    const headings = contentElement.querySelectorAll('h1, h2, h3');
    
    if (headings.length === 0) {
        tocContainer.style.display = 'none';
        return;
    }
    
    tocContainer.style.display = 'block';
    
    // ساخت HTML جدول محتویات
    let tocHTML = '<div class="table-of-contents">';
    tocHTML += '<h4>📑 فهرست مطالب</h4>';
    tocHTML += '<ul>';
    
    headings.forEach((heading, index) => {
        // ایجاد id یکتا برای هر هدینگ
        const id = `heading-${index}-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`;
        heading.id = id;
        
        // اضافه کردن کلاس برای استایل‌بندی
        const level = heading.tagName.toLowerCase();
        heading.classList.add(`toc-heading-${level}`);
        
        // ساخت لینک در TOC
        const text = heading.textContent;
        const levelClass = `toc-level-${level}`;
        
        tocHTML += `
            <li class="${levelClass}">
                <a href="#${id}" class="toc-link" data-target="${id}">
                    ${level === 'h1' ? '📌 ' : level === 'h2' ? '• ' : '◦ '}
                    ${text}
                </a>
            </li>
        `;
    });
    
    tocHTML += '</ul></div>';
    
    tocContainer.innerHTML = tocHTML;
    
   const tocLinks = document.querySelectorAll('.toc-link');
    tocLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.dataset.target;
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
                // اسکرول نرم به بخش مورد نظر
                const offset = 80; // فاصله از بالا (برای navbar)
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - offset;
                
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
                
                // هایلایت کردن بخش
                targetElement.classList.add('section-highlight');
                setTimeout(() => {
                    targetElement.classList.remove('section-highlight');
                }, 1000);
                
                // آپدیت URL بدون رفرش
                history.pushState(null, null, `#${targetId}`);
            }
        });
    });
}

// تابع برای اسکرول به بخش مورد نظر از URL (وقتی صفحه لود میشه)
function scrollToHeadingFromUrl() {
    if (window.location.hash) {
        const targetId = window.location.hash.substring(1);
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
            setTimeout(() => {
                const offset = 80;
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - offset;
                
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
                
                targetElement.classList.add('section-highlight');
                setTimeout(() => {
                    targetElement.classList.remove('section-highlight');
                }, 1000);
            }, 500);
        }
    }
}

function renderStars(rating, reviewsNum) {
  const starsContainer = document.getElementById('stars-container');
  if (!starsContainer) return;
  
  const fullStars = Math.floor(rating || 0);
  const halfStar = (rating || 0) % 1 >= 0.5;
  const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
  
  let starsHtml = '';
  
  // ستاره‌های پر
  for (let i = 0; i < fullStars; i++) {
    starsHtml += `<svg class="w-5 h-5 fill-current text-yellow-400" viewBox="0 0 20 20">
      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
    </svg>`;
  }
  
  // نیم ستاره
  if (halfStar) {
    starsHtml += `<svg class="w-5 h-5 fill-current text-yellow-400" viewBox="0 0 20 20">
      <defs>
        <linearGradient id="halfGrad">
          <stop offset="50%" stop-color="currentColor"/>
          <stop offset="50%" stop-color="#e5e7eb"/>
        </linearGradient>
      </defs>
      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" fill="url(#halfGrad)"/>
    </svg>`;
  }
  
  // ستاره‌های خالی
  for (let i = 0; i < emptyStars; i++) {
    starsHtml += `<svg class="w-5 h-5 fill-current text-gray-300" viewBox="0 0 20 20">
      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
    </svg>`;
  }
  
  starsContainer.innerHTML = starsHtml;
  
  const reviewsSpan = document.getElementById('reviews-count');
  if (reviewsSpan) {
    reviewsSpan.textContent = `(${toPersianDigitsForComments(reviewsNum || 0)} نظر)`;
  }
}

// اجرا کن بعد از لود صفحه
document.addEventListener('DOMContentLoaded', function() {
  const productRating = <%= product?.rating || 0 %>;
  const productReviews = <%= product?.reviewsNum || 0 %>;
  renderStars(productRating, productReviews);

  // SnappPay PDP is rendered without calling the eligible service.

});


</script>
