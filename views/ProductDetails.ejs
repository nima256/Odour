            <%
              const snappPdpRegularPrice = Number(product?.price || 0);
              const snappPdpOfferPrice = Number(product?.offerPrice || 0);
              const snappPdpHasSpecialPrice =
                snappPdpOfferPrice > 0 && snappPdpOfferPrice < snappPdpRegularPrice;

              // Keep PDP installment pricing in sync with checkout:
              // SnappPay keeps 50% of the product's existing special-price discount.
              const snappPdpPayablePrice = snappPdpHasSpecialPrice
                ? snappPdpRegularPrice - Math.floor((snappPdpRegularPrice - snappPdpOfferPrice) / 2)
                : snappPdpRegularPrice;

              const snappPdpInstallmentCount = 4;
              const snappPdpInstallmentAmount = Math.ceil(
                snappPdpPayablePrice / snappPdpInstallmentCount
              );
            %>
            <% if (snappPdpPayablePrice >= 5000) { %>
              <div id="product-snapp-pay" class="snapp-pdp" aria-label="شرایط پرداخت اقساطی اسنپ‌پی">
