    <meta
      name="description"
      content="خرید <%= currentCategory.name %> از فروشگاه لباس کیدل. قیمت <%= currentCategory.name %> با کیفیت عالی و تنوع بالا. بهترین مدل‌های <%= currentCategory.name %> را اینجا ببینید و بخرید."
    />
