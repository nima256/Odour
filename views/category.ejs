    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "<%= currentCategory.name %>",
      "description": "خرید <%= currentCategory.name %> از فروشگاه لوازم آرایشی اودر. قیمت <%= currentCategory.name %> با کیفیت عالی و تنوع بالا. بهترین مدل‌های <%= currentCategory.name %> را اینجا ببینید و بخرید.",
      "url": "https://odour.ir/category/<%= currentCategory.slug %>",
      "numberOfItems": "<%= products.length %>",
      "itemListElement": [
        <% for(let i = 0; i < Math.min(products.length, 10); i++) { %>
        {
          "@type": "ListItem",
          "position": <%= i+1 %>,
          "url": "https://odour.ir/productDetails/<%= products[i].slug %>"
        }<%= i < Math.min(products.length, 10)-1 ? ',' : '' %>
        <% } %>
      ]
    }
