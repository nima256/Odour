    <script>
      // کد مدیریت نمایش فیلترها در موبایل
document.addEventListener('DOMContentLoaded', function() {
  // ایجاد دکمه toggle برای فیلترها در موبایل
  const filtersContainer = document.querySelector('.glass-effect');
  const filtersSidebar = document.querySelector('.xl\\:w-1\\/4');
  const productsContainer = document.querySelector('.xl\\:w-3\\/4');
  
  if (window.innerWidth <= 768) {
    createMobileFiltersToggle();
  }
  
  window.addEventListener('resize', function() {
    if (window.innerWidth <= 768) {
      if (!document.querySelector('.filters-toggle-btn')) {
        createMobileFiltersToggle();
      }
    } else {
      const toggleBtn = document.querySelector('.filters-toggle-btn');
      if (toggleBtn) {
        toggleBtn.remove();
        const filtersContent = document.querySelector('.filters-content');
        if (filtersContent) {
          filtersContent.classList.remove('show');
          filtersContent.style.maxHeight = null;
        }
      }
    }
  });
  
  function createMobileFiltersToggle() {
    // اگه دکمه قبلاً وجود داره، دوباره ایجاد نکن
    if (document.querySelector('.filters-toggle-btn')) return;
    
    // گرفتن المان فیلترها
    const filtersContainer = document.querySelector('.glass-effect');
    if (!filtersContainer) return;
    
    // ذخیره محتوای اصلی فیلترها
    const originalContent = filtersContainer.innerHTML;
    
    // ایجاد دکمه toggle
    const toggleBtn = document.createElement('button');
    toggleBtn.className = 'filters-toggle-btn';
    toggleBtn.innerHTML = `
      <span>
        <i class="fas fa-filter ml-2"></i>
        فیلترهای هوشمند
      </span>
      <i class="fas fa-chevron-down"></i>
    `;
    
    // ایجاد کانتینر برای محتوای فیلترها
    const filtersContent = document.createElement('div');
    filtersContent.className = 'filters-content';
    filtersContent.innerHTML = originalContent;
    
    // پاک کردن محتوای قبلی و اضافه کردن دکمه و محتوای جدید
    filtersContainer.innerHTML = '';
    filtersContainer.appendChild(toggleBtn);
    filtersContainer.appendChild(filtersContent);
    
    // رویداد کلیک برای toggle
    toggleBtn.addEventListener('click', function() {
      this.classList.toggle('active');
      filtersContent.classList.toggle('show');
      
      if (filtersContent.classList.contains('show')) {
        filtersContent.style.maxHeight = filtersContent.scrollHeight + 'px';
      } else {
        filtersContent.style.maxHeight = null;
      }
    });
    
    // باز کردن خودکار فیلترها در حالت موبایل (اختیاری)
    // setTimeout(() => {
    //   toggleBtn.click();
    // }, 100);
  }
  
  // بهینه‌سازی اسکرول دسته‌بندی‌ها در موبایل
  const categoriesSlider = document.getElementById('categoriesSlider');
  if (categoriesSlider && window.innerWidth <= 768) {
    let isScrolling = false;
    let startX;
    let scrollLeft;
    
    categoriesSlider.addEventListener('touchstart', (e) => {
      isScrolling = true;
      startX = e.touches[0].pageX - categoriesSlider.offsetLeft;
      scrollLeft = categoriesSlider.scrollLeft;
    });
    
    categoriesSlider.addEventListener('touchmove', (e) => {
      if (!isScrolling) return;
      e.preventDefault();
      const x = e.touches[0].pageX - categoriesSlider.offsetLeft;
      const walk = (x - startX) * 1.5;
      categoriesSlider.scrollLeft = scrollLeft - walk;
    });
    
    categoriesSlider.addEventListener('touchend', () => {
      isScrolling = false;
    });
  }
});
      document.addEventListener("DOMContentLoaded", function () {
        const selectedCategory = localStorage.getItem("selectedCategory");
        if (selectedCategory) {
          const chip = document.querySelector(
            `.category-chip[data-category="${selectedCategory}"]`
          );
          if (chip) {
            // فعال‌سازی کلاس و اضافه کردن به selectedCategories
            chip.classList.add("active");
            selectedCategories.push(selectedCategory);
            filterProducts(); // اعمال فیلتر
          }
          localStorage.removeItem("selectedCategory"); // پاک کردن برای دفعات بعدی
        }
      });
    </script>
